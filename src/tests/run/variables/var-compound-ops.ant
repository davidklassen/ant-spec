// run
// spec: 3 variables; 5 operators; 12 assignment
// gap: G6
import "../../lib/expect.ant" Expect

func main() {
  var n = 10
  n += 5; Expect.eq(n, 15, "+= int")
  n -= 3; Expect.eq(n, 12, "-= int")
  n *= 4; Expect.eq(n, 48, "*= int")
  n /= 5; Expect.eq(n, 9, "/= int truncates toward zero")
  n %= 4; Expect.eq(n, 1, "%= int")
  var m = -7
  m %= 3; Expect.eq(m, -1, "%= keeps the sign of the dividend")

  var f = 10.0
  f += 2.5; Expect.eq(f, 12.5, "+= float")
  f -= 0.5; Expect.eq(f, 12.0, "-= float")
  f *= 2.0; Expect.eq(f, 24.0, "*= float")
  f /= 4.0; Expect.eq(f, 6.0, "/= float")
  f %= 2.5; Expect.eq(f, 1.0, "%= float")

  var s = "ant"
  s += "-lang"; Expect.eq(s, "ant-lang", "+= string concatenates")
}
