// run
// spec: 11 Array.map; 4 primitives void
// gap: G35
// output:
//  1
//  2
import "../../lib/expect.ant" Expect

func main() {
  var ys = Array.map([1, 2], { print(x) })
  Expect.eq(Array.length(ys), 2, "one element per input")
  Expect.isTrue(ys[0] == void, "elements are void")
  Expect.isTrue(ys[1] == void, "elements are void")
}
