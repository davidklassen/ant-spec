// run
// spec: 11 Math.PI, Math.E
import "../../lib/expect.ant" Expect

func main() {
  Expect.isTrue(Math.abs(Math.PI - 3.141592653589793) < 1e-15, "PI")
  Expect.isTrue(Math.abs(Math.E - 2.718281828459045) < 1e-15, "E")
  Expect.isTrue(Math.PI > 3.14 && Math.PI < 3.15, "PI magnitude")
  Expect.isTrue(Math.E > 2.71 && Math.E < 2.72, "E magnitude")
}
