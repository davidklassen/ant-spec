// run
// spec: 11 Array.push, Array.pop
// gap: G34
import "../../lib/expect.ant" Expect

func main() {
  var xs = [1]
  Array.push(xs, 2)
  Array.push(xs, 3)
  Expect.eq(xs, [1, 2, 3], "push appends in order")
  Expect.eq(Array.pop(xs) ?? -1, 3, "pop returns the last element")
  Expect.eq(xs, [1, 2], "pop shrinks the array")
  Expect.eq(Array.pop(xs) ?? -1, 2, "pop again")
  Expect.eq(Array.pop(xs) ?? -1, 1, "pop to empty")
  Expect.isTrue(Array.isEmpty(xs), "empty after three pops")
  Expect.isNull(Array.pop(xs), "pop on an empty array is null")
  Expect.eq(Array.length(xs), 0, "still empty")
}
