// run
// spec: 11 Array.sum
import "../../lib/expect.ant" Expect

func main() {
  Expect.eq(Array.sum([1, 2, 3]) ?? 0, 6, "ints")
  Expect.eq(Array.sum([-5]) ?? 0, -5, "single negative")
  Expect.eq(Array.sum([0.5, 0.25]) ?? 0.0, 0.75, "floats")
  Expect.eq(Array.sum([int8(1), int8(2)]) ?? int8(0), int8(3), "int8")
  var none: Array[int] = []
  Expect.isNull(Array.sum(none), "empty is null")
  var nofloats: Array[float64] = []
  Expect.eq(Array.sum(nofloats) ?? 0.0, 0.0, "empty with a default")
}
