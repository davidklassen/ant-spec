// run
// spec: 11 Math.min, Math.max; 12 comparison
import "../../lib/expect.ant" Expect

func main() {
  Expect.eq(Math.min(1, 2), 1, "min ints")
  Expect.eq(Math.max(1, 2), 2, "max ints")
  Expect.eq(Math.min(-1, -2), -2, "min negative")
  Expect.eq(Math.min(2.5, -0.5), -0.5, "min floats")
  Expect.eq(Math.max(2.5, -0.5), 2.5, "max floats")
  Expect.eq(Math.min("b", "a"), "a", "min strings")
  Expect.eq(Math.max("a", "é"), "é", "max strings by code point")
  Expect.eq(Math.min(int8(3), int8(-3)), int8(-3), "min int8")
  Expect.eq(Math.max(uint8(3), uint8(200)), uint8(200), "max uint8")
  Expect.eq(Math.min(4, 4), 4, "equal operands")
}
