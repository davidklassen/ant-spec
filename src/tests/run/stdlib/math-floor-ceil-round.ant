// run
// spec: 11 Math.floor, Math.ceil, Math.round
import "../../lib/expect.ant" Expect

func main() {
  Expect.eq(Math.floor(1.5), 1.0, "floor")
  Expect.eq(Math.floor(-1.5), -2.0, "floor of a negative")
  Expect.eq(Math.ceil(1.5), 2.0, "ceil")
  Expect.eq(Math.ceil(-1.5), -1.0, "ceil of a negative")
  Expect.eq(Math.floor(2.0), 2.0, "floor of an integer value")
  Expect.eq(Math.round(2.4), 2.0, "round down")
  Expect.eq(Math.round(2.5), 3.0, "half rounds away from zero")
  Expect.eq(Math.round(-2.5), -3.0, "negative half rounds away from zero")
  Expect.eq(Math.round(1.5), 2.0, "half up")
  Expect.eq(Math.round(-0.5), -1.0, "negative half")
  Expect.eq(Math.round(0.49999999999999994), 0.0, "just below a half")
}
