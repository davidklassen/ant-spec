// run
// spec: 11 prelude print; 11 String.from; 4 records
// gap: G33
// output:
//   Node{ name: "a", next: ... }
//   Node{ name: "b", next: Node{ name: "c", next: ... } }
//   Tree{ kids: [...] }
//   [Node{ name: "leaf", next: null }, Node{ name: "leaf", next: null }]
type Node = { name: string, next: Node | null }
type Tree = { kids: Array[Tree] }

func main() {
  var a = Node{ name: "a", next: null }
  a.next = a
  print(a)
  var b = Node{ name: "b", next: null }
  var c = Node{ name: "c", next: b }
  b.next = c
  print(b)
  var t = Tree{ kids: [] }
  Array.push(t.kids, t)
  print(t)
  var leaf = Node{ name: "leaf", next: null }
  print([leaf, leaf])
}
