// run
// spec: 9 panics in goroutines; 8 panic; 12 deferred blocks and panics
// stderr: panic: worker failed
// output:
//   continued
func main() {
  var wg = WaitGroup.new()
  WaitGroup.add(wg, 1)
  go {
    defer { WaitGroup.done(wg) }
    panic("worker failed")
  }
  WaitGroup.wait(wg)
  print("continued")
}
