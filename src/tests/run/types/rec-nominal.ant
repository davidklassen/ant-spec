// run
// spec: 4 records (nominal, identified by tag); 5 is; 12 equality
import "../../lib/expect.ant" Expect

type Point = { x: float64, y: float64 }
type Vec = { x: float64, y: float64 }

func main() {
  var v: Point | Vec = Vec{ x: 1.0, y: 2.0 }
  Expect.isTrue(v is Vec, "a Vec is a Vec")
  Expect.isFalse(v is Point, "a Vec is not a Point")
  var p: Point | Vec = Point{ x: 1.0, y: 2.0 }
  Expect.isTrue(p is Point, "a Point is a Point")
  Expect.isFalse(p == v, "same fields, different tags: unequal")
  Expect.isTrue(p != v, "!= agrees")
  Expect.isTrue(p == Point{ x: 1.0, y: 2.0 }, "equal to a Point with the same fields")
}
