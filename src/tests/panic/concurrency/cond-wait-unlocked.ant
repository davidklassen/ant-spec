// panic
// spec: 11 synchronization Cond (wait: m not locked); 12 runtime panics
// panic: not locked
// output:
//   released
func main() {
  var lock = Mutex.new()
  var cond = Cond.new(lock)
  Mutex.lock(lock)
  Mutex.unlock(lock)
  print("released")
  Cond.wait(cond)                       // the caller does not hold lock
}
