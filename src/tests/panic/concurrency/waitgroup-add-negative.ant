// panic
// spec: 11 synchronization WaitGroup (add: counter would go negative); 12 runtime panics
// panic: negative counter
// output:
//   at zero
func main() {
  var wg = WaitGroup.new()
  WaitGroup.add(wg, 1)
  WaitGroup.add(wg, -1)                 // back to zero: fine
  print("at zero")
  WaitGroup.add(wg, -1)
}
