// panic
// spec: 11 synchronization RwMutex (readUnlock: not read-locked); 12 runtime panics
// panic: not locked
// output:
//   write-locked
func main() {
  var rw = RwMutex.new()
  RwMutex.writeLock(rw)
  print("write-locked")
  RwMutex.readUnlock(rw)                // held for writing, not for reading
}
