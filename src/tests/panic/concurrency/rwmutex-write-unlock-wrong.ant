// panic
// spec: 11 synchronization RwMutex (writeUnlock: not write-locked); 12 runtime panics
// panic: not locked
// output:
//  read-locked
func main() {
  var rw = RwMutex.new()
  RwMutex.readLock(rw)
  print("read-locked")
  RwMutex.writeUnlock(rw)               // held for reading, not for writing
}
