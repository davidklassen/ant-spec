// panic
// spec: 5 loops (panics in the body propagate through the sequence); 12 deferred blocks and panics
// panic: boom
// output:
//  seq defer
func seq(yield: func(int): bool) {
  defer { print("seq defer") }
  if !yield(1) { return }
  print("not reached")
}

func main() {
  for n in seq { panic("boom") }
}
