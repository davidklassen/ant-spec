// program
// spec: 11 Map (index read and write); 11 String (split); 11 Array (sort); 7 nullability (??)
// output:
//  and: 2
//  bird: 1
//  cat: 1
//  dog: 1
//  the: 3
func main() {
  var text = "the cat and the dog and the bird"
  var counts: Map[string, int] = Map{}
  for word in String.split(text, " ") {
    counts[word] = (counts[word] ?? 0) + 1
  }
  for word in Array.sort(Map.keys(counts)) {
    print(`${word}: ${counts[word] ?? 0}`)
  }
}
