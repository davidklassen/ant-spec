// program
// spec: 4 generics (bounds); 11 Array (filter, slice, concat); 6 lambdas
// gap: G15
// output:
//   1 2 5 5 6 9
//   apple fig pear
func quicksort[T: Ordered](xs: Array[T]): Array[T] {
  if Array.length(xs) <= 1 { return xs }
  var pivot = xs[0]
  var rest = Array.slice(xs, 1, Array.length(xs))
  var less = Array.filter(rest, { x < pivot })
  var more = Array.filter(rest, { x >= pivot })
  Array.concat(Array.concat(quicksort(less), [pivot]), quicksort(more))
}

func show[T](xs: Array[T]): string {
  String.join(Array.map(xs, { String.from(x) }), " ")
}

func main() {
  print(show(quicksort([5, 2, 9, 1, 5, 6])))
  print(show(quicksort(["pear", "apple", "fig"])))
}
