// program
// spec: 4 tagged unions; 7 nullability (narrowing by is); 5 loops (sequences)
// source: go:test/typeparam/tree.go
// output:
//  1
//  3
//  4
//  5
//  7
//  8
//  9
type Leaf = {}
type Node = { left: Tree, value: int, right: Tree }
type Tree = Leaf | Node

func insert(t: Tree, v: int): Tree {
  if t is Node {
    if v < t.value { t.left = insert(t.left, v) }
    else if v > t.value { t.right = insert(t.right, v) }
    t
  } else {
    Node{ left: Leaf{}, value: v, right: Leaf{} }
  }
}

// Pushes the values in order; false as soon as the consumer stops.
func walk(t: Tree, yield: func(int): bool): bool {
  if t is Node { walk(t.left, yield) && yield(t.value) && walk(t.right, yield) }
  else { true }
}

func inorder(t: Tree): Seq[int] {
  func(yield: func(int): bool) {
    walk(t, yield)
    void
  }
}

func main() {
  var tree: Tree = Leaf{}
  for v in [5, 3, 8, 1, 4, 7, 9, 3] { tree = insert(tree, v) }
  for v in inorder(tree) { print(v) }
}
