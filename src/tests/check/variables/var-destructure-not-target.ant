// check
// spec: 3 variables (assignment targets); 5 destructuring
// gap: G42
type Point = { x: int, y: int }

// The grammar has no destructuring assignment, so `{ x, y } = p` does not even
// parse. With one field the braces parse as a lambda, which is not a target either.
func main() {
  var p = Point{ x: 1, y: 2 }
  var x = 0
  { x } = p                      // ERROR "cannot assign"
}
