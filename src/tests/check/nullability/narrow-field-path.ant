// check
// spec: 7 nullability
// source: spec
type Addr = { city: string }
type User = { name: string, address: Addr | null }

func city(user: User): string {
  if user.address != null { user.address.city } else { "unknown" }    // ERROR "does not narrow"
}

func main() {
  city(User{ name: "ada", address: null })
}
