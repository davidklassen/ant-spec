// unchecked
// spec: 4 generics (the interpreter never sees a bound); 12 comparison (an operand is not a number)
// panic: not a number
// output:
//   before
func max[T: Ordered](a: T, b: T): T { if a > b { a } else { b } }

func main() {
  print("before")
  var m = max(true, false)             // ERROR "does not satisfy bound"
  print("after")
}
