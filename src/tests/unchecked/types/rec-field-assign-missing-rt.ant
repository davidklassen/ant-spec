// unchecked
// spec: 12 assignment (a field target must be a record that already has that field); 12 runtime panics
// panic: no field
// output:
//   before
type Point = { x: float64, y: float64 }

func main() {
  var p = Point{ x: 1.0, y: 2.0 }
  print("before")
  p.z = 1.0                // ERROR "unknown field"
}
