// io
// spec: stdlib Json; 5 is; 4 unions
// gap: G57
// output:
//  null
//  bool
//  float64
//  string
//  Array
//  Map
func main() {
  for text in ["null", "true", "3.5", "\"s\"", "[1, 2]", "{\"k\": 1}"] {
    var j = Result.unwrap(Json.parse(text))
    if j is null { print("null") }
    else if j is bool { print("bool") }
    else if j is float64 { print("float64") }
    else if j is string { print("string") }
    else if j is Array { print("Array") }
    else if j is Map { print("Map") }
  }
}
