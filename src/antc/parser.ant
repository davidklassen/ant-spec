// The antc parser: tokens to the AST of ast.ant (ant-lang.md sections 2-6,
// 10; grammar.ebnf).
//
// It mirrors the Parser class of tools/antparse.py method by method, so that
// tools/compare_frontend.py can diff the two: the same tree, and every error
// with the message and at the position the reference reports it. Positions
// are those of the token `peek` returns at the moment an error is raised,
// which is often after a sub-expression was parsed; `expected newline or ';'`
// uses the raw token. Mirror the call order, not the intent: the shared
// helpers (`delimited`, `grouped`, `optionalAfter`, `binLevel`) make exactly
// the peek and expect calls their inlined forms made, in the same order.
import "./lexer.ant" Lex
import "./ast.ant" Ast

// The parser state. `nl > 0` means newlines are ignored (inside parentheses,
// brackets and non-block braces); `header` is set while parsing the header of
// an if, while or for, where `{` after an identifier path opens the block
// rather than a record literal.
type Parser = { toks: Array[Lex.Token], i: int, nl: int, header: bool }
type Saved = { nl: int, header: bool }
// A parsed parameter list and return type.
type Sig = { params: Array[Ast.Param], ret: Ast.TypeExpr | null }

// Operator and keyword sets, tested with isAny.
var ASSIGN_OPS = Map{ "=": true, "+=": true, "-=": true, "*=": true, "/=": true, "%=": true }
var EQUALITY_OPS = Map{ "==": true, "!=": true }
var COMPARE_OPS = Map{ "<": true, "<=": true, ">": true, ">=": true }
var ADDITIVE_OPS = Map{ "+": true, "-": true }
var MULTIPLICATIVE_OPS = Map{ "*": true, "/": true, "%": true }
var UNARY_OPS = Map{ "-": true, "!": true, "try": true }
var POSTFIX_OPS = Map{ ".": true, "?.": true, "[": true, "(": true }
// Closers after which `return` is bare.
var RETURN_ENDERS = Map{ ";": true, "}": true, ")": true, "]": true, ",": true }
var DECL_KWS = Map{ "export": true, "var": true, "func": true, "type": true }
var LITERAL_KWS = Map{ "true": true, "false": true, "null": true, "void": true }
var MIX_MESSAGE = "'??' cannot mix with '&&' or '||' without parentheses"

export func parse(src: string): Result[Ast.Module, Lex.Diagnostic] {
  parseFile(Parser{ toks: try Lex.tokenize(src), i: 0, nl: 0, header: false })
}

// --- token helpers

// The current token, newlines included.
func raw(p: Parser): Lex.Token {
  p.toks[p.i]
}

// The current token, skipping newlines when they are ignored. The skip
// advances the position for good, as the reference does.
func peek(p: Parser): Lex.Token {
  while p.nl > 0 && p.toks[p.i].kind == "NEWLINE" { p.i += 1 }
  p.toks[p.i]
}

func next(p: Parser): Lex.Token {
  var t = peek(p)
  p.i += 1
  t
}

// Whether t is the operator or keyword `value`.
func isWord(t: Lex.Token, value: string): bool {
  t.value == value && (t.kind == "OP" || t.kind == "KW")
}

// Whether t is one of the operators or keywords in `words`.
func isAny(t: Lex.Token, words: Map[string, bool]): bool {
  Map.has(words, t.value) && (t.kind == "OP" || t.kind == "KW")
}

// Whether the next token is the operator or keyword `value`.
func at(p: Parser, value: string): bool {
  isWord(peek(p), value)
}

func atKind(p: Parser, kind: string): bool {
  peek(p).kind == kind
}

func failAt(t: Lex.Token, message: string): Lex.Diagnostic {
  Lex.Diagnostic{ line: t.line, col: t.col, message }
}

// An error at the next token.
func fail(p: Parser, message: string): Lex.Diagnostic {
  failAt(peek(p), message)
}

// `<message>, got <token>` at t: the form of every "expected ..." error.
func failGot(t: Lex.Token, message: string): Lex.Diagnostic {
  failAt(t, `${message}, got ${describe(t)}`)
}

func expect(p: Parser, value: string): Result[Lex.Token, Lex.Diagnostic] {
  var t = peek(p)
  if !isWord(t, value) { return Result.err(failGot(t, `expected '${value}'`)) }
  p.i += 1
  Result.ok(t)
}

// The next token when it has this kind, else `expected <what>, got ...`.
func expectKind(p: Parser, kind: string, what: string): Result[Lex.Token, Lex.Diagnostic] {
  var t = peek(p)
  if t.kind != kind { return Result.err(failGot(t, `expected ${what}`)) }
  p.i += 1
  Result.ok(t)
}

func expectIdent(p: Parser, what: string = "identifier"): Result[string, Lex.Diagnostic] {
  var t = try expectKind(p, "IDENT", what)
  Result.ok(t.value)
}

// The rest of an identifier path `a.b.c` after its first name.
func identPath(p: Parser, first: string): Result[Array[string], Lex.Diagnostic] {
  var path: Array[string] = [first]
  while at(p, ".") {
    next(p)
    Array.push(path, try expectIdent(p))
  }
  Result.ok(path)
}

// Skips newlines and semicolons; returns how many.
func skipTerms(p: Parser): int {
  var n = 0
  var t = raw(p)
  while t.kind == "NEWLINE" || isWord(t, ";") {
    p.i += 1
    n += 1
    t = raw(p)
  }
  n
}

// A statement must be followed by a terminator, a `}` or the end of the file.
func expectTerm(p: Parser): Result[void, Lex.Diagnostic] {
  var t = raw(p)
  if t.kind == "EOF" || isWord(t, "}") { return Result.ok(void) }
  if skipTerms(p) == 0 {
    return Result.err(failGot(t, "expected newline or ';'"))
  }
  Result.ok(void)
}

// The reference's Token.__repr__, used in `got ...` messages.
func describe(t: Lex.Token): string {
  if t.kind == "OP" || t.kind == "KW" { `'${t.value}'` }
  else if t.kind == "NEWLINE" { "newline" }
  else if t.kind == "EOF" { "end of file" }
  else { `${String.toLower(t.kind)} ${pyRepr(t.value)}` }
}

// Python's repr of a str: single quotes unless the text holds a single quote
// and no double quote; backslash, the quote, LF, CR and tab escaped by
// letter, other ASCII control characters as \xNN. (Python also escapes
// non-printable code points outside ASCII; none occur in a token.)
func pyRepr(s: string): string {
  var quote = if String.contains(s, "'") && !String.contains(s, "\"") { "\"" } else { "'" }
  var out: Array[string] = [quote]
  for c in s {
    if c == "\\" { Array.push(out, "\\\\") }
    else if c == quote { Array.push(out, "\\" + quote) }
    else if c == "\n" { Array.push(out, "\\n") }
    else if c == "\r" { Array.push(out, "\\r") }
    else if c == "\t" { Array.push(out, "\\t") }
    else if c < " " || c == "\u{7f}" { Array.push(out, "\\x" + hex2(int(String.toBytes(c)[0]))) }
    else { Array.push(out, c) }
  }
  Array.push(out, quote)
  String.concat(out)
}

func hex2(n: int): string {
  var digits = String.chars("0123456789abcdef")
  digits[n / 16] + digits[n % 16]
}

// --- scopes for newline sensitivity and headers

// Enters a scope with the given newline sensitivity (0 for a block, where
// newlines terminate statements; p.nl + 1 for a bracketed list, where they
// are ignored) and the header flag off; returns what `leave` restores.
func enter(p: Parser, nl: int): Saved {
  var saved = Saved{ nl: p.nl, header: p.header }
  p.nl = nl
  p.header = false
  saved
}

func leave(p: Parser, saved: Saved): void {
  p.nl = saved.nl
  p.header = saved.header
}

// `open item, item, ... close`: a bracketed, comma-separated list with
// newlines ignored inside and a trailing comma allowed.
func delimited[T](p: Parser, open: string, close: string, item: func(Parser): Result[T, Lex.Diagnostic]): Result[Array[T], Lex.Diagnostic] {
  try expect(p, open)
  var saved = enter(p, p.nl + 1)
  var items: Array[T] = []
  while !at(p, close) {
    Array.push(items, try item(p))
    if !at(p, close) { try expect(p, ",") }
  }
  try expect(p, close)
  leave(p, saved)
  Result.ok(items)
}

// `open inner close` with newlines ignored inside.
func grouped[T](p: Parser, open: string, close: string, inner: func(Parser): Result[T, Lex.Diagnostic]): Result[T, Lex.Diagnostic] {
  try expect(p, open)
  var saved = enter(p, p.nl + 1)
  var x = try inner(p)
  try expect(p, close)
  leave(p, saved)
  Result.ok(x)
}

// What `parse` reads after `sep`, or null when `sep` is not next.
func optionalAfter[T](p: Parser, sep: string, parse: func(Parser): Result[T, Lex.Diagnostic]): Result[T | null, Lex.Diagnostic] {
  if !at(p, sep) { return Result.ok(null) }
  next(p)
  Result.ok(try parse(p))
}

// --- file

func parseFile(p: Parser): Result[Ast.Module, Lex.Diagnostic] {
  var imports: Array[Ast.Import] = []
  var decls: Array[Ast.Decl] = []
  skipTerms(p)
  while at(p, "import") {
    Array.push(imports, try importDecl(p))
    skipTerms(p)
  }
  while !atKind(p, "EOF") {
    if at(p, "import") { return Result.err(fail(p, "import must come before declarations")) }
    var t = peek(p)
    if !isAny(t, DECL_KWS) { return Result.err(failGot(t, "expected declaration")) }
    Array.push(decls, try declaration(p))
    try expectTerm(p)
    skipTerms(p)
  }
  Result.ok(Ast.Module{ imports, decls })
}

func importDecl(p: Parser): Result[Ast.Import, Lex.Diagnostic] {
  var kw = try expect(p, "import")
  var path = try expectKind(p, "STRING", "module path string")
  var pattern: Ast.ImportPattern = if atKind(p, "IDENT") {
    var t = next(p)
    Ast.Namespace{ line: t.line, col: t.col, name: t.value }
  } else {
    var open = peek(p)
    var items = try delimited(p, "{", "}", { aliasItem(x, "export name") })
    Ast.Names{ line: open.line, col: open.col, items }
  }
  try expectTerm(p)
  Result.ok(Ast.Import{ line: kw.line, col: kw.col, path: path.value, pattern })
}

// `name` or `name: local`, an import item or a destructure field; `what`
// names the first identifier in the error message.
func aliasItem(p: Parser, what: string): Result[Ast.Alias, Lex.Diagnostic] {
  var t = peek(p)
  var name = try expectIdent(p, what)
  var alias = try optionalAfter(p, ":", { expectIdent(x, "local name") })
  Result.ok(Ast.Alias{ line: t.line, col: t.col, name, alias })
}

func declaration(p: Parser): Result[Ast.Decl, Lex.Diagnostic] {
  var exported = false
  if at(p, "export") {
    next(p)
    exported = true
  }
  var t = peek(p)
  var d: Ast.Decl = if t.value == "var" { try varDecl(p, exported) }
    else if t.value == "func" { try funcDecl(p, exported) }
    else if t.value == "type" { try typeDecl(p, exported) }
    else { return Result.err(failGot(t, "expected var, func, or type after export")) }
  Result.ok(d)
}

func varDecl(p: Parser, exported: bool): Result[Ast.VarDecl, Lex.Diagnostic] {
  var kw = try expect(p, "var")
  var typ: Ast.TypeExpr | null = null
  var target: Ast.Target = if at(p, "{") { try destructure(p) }
    else if atKind(p, "IDENT") {
      var t = next(p)
      typ = try optionalAfter(p, ":", typeExpr)
      Ast.Name{ line: t.line, col: t.col, name: t.value }
    } else {
      return Result.err(failGot(peek(p), "expected identifier or '{' after var"))
    }
  try expect(p, "=")
  var value = try expression(p)
  Result.ok(Ast.VarDecl{ line: kw.line, col: kw.col, exported, target, typ, value })
}

func funcDecl(p: Parser, exported: bool): Result[Ast.FuncDecl, Lex.Diagnostic] {
  var kw = try expect(p, "func")
  var name = try expectIdent(p, "function name")
  var tparams = try typeParams(p)
  var sig = try signature(p)
  var body = try block(p)
  Result.ok(Ast.FuncDecl{ line: kw.line, col: kw.col, exported, name, tparams, params: sig.params, ret: sig.ret, body })
}

func typeDecl(p: Parser, exported: bool): Result[Ast.TypeDecl, Lex.Diagnostic] {
  var kw = try expect(p, "type")
  var name = try expectIdent(p, "type name")
  var tparams = try typeParams(p)
  try expect(p, "=")
  var body = try typeExpr(p)
  Result.ok(Ast.TypeDecl{ line: kw.line, col: kw.col, exported, name, tparams, body })
}

// `[T, U: Bound]` when it is next, else no type parameters.
func typeParams(p: Parser): Result[Array[Ast.TypeParam], Lex.Diagnostic] {
  if !at(p, "[") { return Result.ok([]) }
  delimited(p, "[", "]", typeParam)
}

func typeParam(p: Parser): Result[Ast.TypeParam, Lex.Diagnostic] {
  var t = peek(p)
  var name = try expectIdent(p, "type parameter")
  var bound = try optionalAfter(p, ":", typeExpr)
  Result.ok(Ast.TypeParam{ line: t.line, col: t.col, name, bound })
}

func signature(p: Parser): Result[Sig, Lex.Diagnostic] {
  var params = try delimited(p, "(", ")", param)
  var ret = try optionalAfter(p, ":", typeExpr)
  Result.ok(Sig{ params, ret })
}

func param(p: Parser): Result[Ast.Param, Lex.Diagnostic] {
  var t = peek(p)
  var name = try expectIdent(p, "parameter name")
  try expect(p, ":")
  var typ = try typeExpr(p)
  var default = try optionalAfter(p, "=", expression)
  Result.ok(Ast.Param{ line: t.line, col: t.col, name, typ, default })
}

// --- types

func typeExpr(p: Parser): Result[Ast.TypeExpr, Lex.Diagnostic] {
  var first = try typeTerm(p)
  var terms: Array[Ast.TypeExpr] = [first]
  while at(p, "|") {
    next(p)
    Array.push(terms, try typeTerm(p))
  }
  if Array.length(terms) == 1 { Result.ok(first) }
  else { Result.ok(Ast.Union{ line: first.line, col: first.col, terms }) }
}

func typeTerm(p: Parser): Result[Ast.TypeExpr, Lex.Diagnostic] {
  var t = peek(p)
  if isWord(t, "null") || isWord(t, "void") {
    next(p)
    return Result.ok(Ast.TPath{ line: t.line, col: t.col, path: [t.value], args: [] })
  }
  if isWord(t, "{") { return Result.ok(try recordType(p)) }
  if isWord(t, "func") { return Result.ok(try funcType(p)) }
  if isWord(t, "(") { return grouped(p, "(", ")", typeExpr) }
  var first = try expectKind(p, "IDENT", "type")
  var path = try identPath(p, first.value)
  var args: Array[Ast.TypeExpr] = if at(p, "[") { try delimited(p, "[", "]", typeExpr) } else { [] }
  Result.ok(Ast.TPath{ line: t.line, col: t.col, path, args })
}

func recordType(p: Parser): Result[Ast.TRecord, Lex.Diagnostic] {
  var open = peek(p)
  var fields = try delimited(p, "{", "}", fieldType)
  Result.ok(Ast.TRecord{ line: open.line, col: open.col, fields })
}

func fieldType(p: Parser): Result[Ast.FieldType, Lex.Diagnostic] {
  var t = peek(p)
  var name = try expectIdent(p, "field name")
  try expect(p, ":")
  var typ = try typeExpr(p)
  Result.ok(Ast.FieldType{ line: t.line, col: t.col, name, typ })
}

func funcType(p: Parser): Result[Ast.TFunc, Lex.Diagnostic] {
  var kw = try expect(p, "func")
  var params = try delimited(p, "(", ")", ftParam)
  try expect(p, ":")
  var ret = try typeExpr(p)
  Result.ok(Ast.TFunc{ line: kw.line, col: kw.col, params, ret })
}

// `type` or `name: type`; the name is first read as a one-identifier type path.
func ftParam(p: Parser): Result[Ast.FtParam, Lex.Diagnostic] {
  var t = peek(p)
  var typ = try typeExpr(p)
  var name: string | null = null
  if at(p, ":") {
    if typ is Ast.TPath && Array.length(typ.path) == 1 && Array.isEmpty(typ.args) {
      name = typ.path[0]
      next(p)
      typ = try typeExpr(p)
    } else {
      return Result.err(fail(p, "expected ',' or ')' in function type"))
    }
  }
  Result.ok(Ast.FtParam{ line: t.line, col: t.col, name, typ })
}

// --- blocks and statements

func block(p: Parser): Result[Ast.Block, Lex.Diagnostic] {
  var open = try expect(p, "{")
  var saved = enter(p, 0)
  var stmts = try statements(p)
  try expect(p, "}")
  leave(p, saved)
  Result.ok(Ast.Block{ line: open.line, col: open.col, stmts })
}

func statements(p: Parser): Result[Array[Ast.Stmt], Lex.Diagnostic] {
  var stmts: Array[Ast.Stmt] = []
  skipTerms(p)
  while !at(p, "}") {
    if atKind(p, "EOF") { return Result.err(fail(p, "expected '}', got end of file")) }
    Array.push(stmts, try statement(p))
    if at(p, "}") { break }
    try expectTerm(p)
    skipTerms(p)
  }
  Result.ok(stmts)
}

func statement(p: Parser): Result[Ast.Stmt, Lex.Diagnostic] {
  var t = peek(p)
  if t.kind == "KW" {
    if t.value == "var" { return Result.ok(try varDecl(p, false)) }
    if t.value == "type" {
      return Result.err(failAt(t, "type declarations are only allowed at the top level"))
    }
    if t.value == "export" || t.value == "import" {
      return Result.err(failAt(t, `'${t.value}' is only allowed at the top level`))
    }
  }
  Result.ok(try expression(p))
}

// A lambda is a block in expression position: the same braces and statements.
func lambda(p: Parser): Result[Ast.Lambda, Lex.Diagnostic] {
  var b = try block(p)
  Result.ok(Ast.Lambda{ line: b.line, col: b.col, stmts: b.stmts })
}

// --- expressions

func expression(p: Parser): Result[Ast.Expr, Lex.Diagnostic] {
  var left = try pipe(p)
  var t = peek(p)
  if !isAny(t, ASSIGN_OPS) { return Result.ok(left) }
  p.i += 1
  var right = try pipe(p)
  if isAny(peek(p), ASSIGN_OPS) { return Result.err(fail(p, "assignment cannot be chained")) }
  Result.ok(Ast.Assign{ line: t.line, col: t.col, op: t.value, target: left, value: right })
}

func pipe(p: Parser): Result[Ast.Expr, Lex.Diagnostic] {
  var left = try pipeOperand(p)
  while at(p, "|") {
    var op = next(p)
    var right = try postfix(p)
    if !(right is Ast.Call) { return Result.err(fail(p, "pipe right side must be a call")) }
    left = Ast.Pipe{ line: op.line, col: op.col, left, right }
  }
  Result.ok(left)
}

// `??` chains, or `&&`/`||` chains with `&&` binding tighter; the two kinds
// cannot mix without parentheses.
func pipeOperand(p: Parser): Result[Ast.Expr, Lex.Diagnostic] {
  var left = try equality(p)
  var t = peek(p)
  if isWord(t, "??") {
    while at(p, "??") {
      var op = next(p)
      var right = try equality(p)
      left = Ast.Nullish{ line: op.line, col: op.col, left, right }
    }
    if at(p, "&&") || at(p, "||") { return Result.err(fail(p, MIX_MESSAGE)) }
    return Result.ok(left)
  }
  if isWord(t, "&&") || isWord(t, "||") {
    while at(p, "&&") {
      var op = next(p)
      var right = try equality(p)
      left = Ast.And{ line: op.line, col: op.col, left, right }
    }
    while at(p, "||") {
      var op = next(p)
      var right = try equality(p)
      while at(p, "&&") {
        var andOp = next(p)
        var more = try equality(p)
        right = Ast.And{ line: andOp.line, col: andOp.col, left: right, right: more }
      }
      left = Ast.Or{ line: op.line, col: op.col, left, right }
    }
    if at(p, "??") { return Result.err(fail(p, MIX_MESSAGE)) }
  }
  Result.ok(left)
}

// A left-associative level of binary operators over `operand`.
func binLevel(p: Parser, ops: Map[string, bool], operand: func(Parser): Result[Ast.Expr, Lex.Diagnostic]): Result[Ast.Expr, Lex.Diagnostic] {
  var left = try operand(p)
  var op = peek(p)
  while isAny(op, ops) {
    p.i += 1
    var right = try operand(p)
    left = Ast.Bin{ line: op.line, col: op.col, op: op.value, left, right }
    op = peek(p)
  }
  Result.ok(left)
}

func equality(p: Parser): Result[Ast.Expr, Lex.Diagnostic] {
  binLevel(p, EQUALITY_OPS, comparison)
}

func comparison(p: Parser): Result[Ast.Expr, Lex.Diagnostic] {
  var left = try additive(p)
  var t = peek(p)
  while isAny(t, COMPARE_OPS) || isWord(t, "is") {
    p.i += 1
    if t.kind == "OP" {
      var right = try additive(p)
      left = Ast.Bin{ line: t.line, col: t.col, op: t.value, left, right }
    } else {
      var target = try isTarget(p)
      left = Ast.Is{ line: t.line, col: t.col, value: left, target }
    }
    t = peek(p)
  }
  Result.ok(left)
}

// After `is`: `null`, `func`, or an identifier path.
func isTarget(p: Parser): Result[Array[string], Lex.Diagnostic] {
  var t = peek(p)
  if isWord(t, "null") || isWord(t, "func") {
    next(p)
    return Result.ok([t.value])
  }
  var first = try expectKind(p, "IDENT", "type name after 'is'")
  identPath(p, first.value)
}

func additive(p: Parser): Result[Ast.Expr, Lex.Diagnostic] {
  binLevel(p, ADDITIVE_OPS, multiplicative)
}

func multiplicative(p: Parser): Result[Ast.Expr, Lex.Diagnostic] {
  binLevel(p, MULTIPLICATIVE_OPS, unary)
}

func unary(p: Parser): Result[Ast.Expr, Lex.Diagnostic] {
  var t = peek(p)
  if isAny(t, UNARY_OPS) {
    next(p)
    var operand = try unary(p)
    return Result.ok(Ast.Unary{ line: t.line, col: t.col, op: t.value, operand })
  }
  postfix(p)
}

// --- postfix and calls

func postfix(p: Parser): Result[Ast.Expr, Lex.Diagnostic] {
  var start = peek(p)
  var node = try primary(p)
  // An identifier path `a.b.c` followed by `{` is a record literal.
  var isPath = node is Ast.Ident
  var path: Array[string] = if node is Ast.Ident { [node.name] } else { [] }
  var t = peek(p)
  while isAny(t, POSTFIX_OPS) {
    if t.value == "." {
      next(p)
      var name = try expectIdent(p)
      node = Ast.Field{ line: t.line, col: t.col, object: node, name }
      if isPath {
        Array.push(path, name)
        if at(p, "{") && !p.header { return braceLit(p, path, start.line, start.col) }
      }
    } else if t.value == "?." {
      next(p)
      isPath = false
      if at(p, "[") {
        var index = try indexExpr(p)
        node = Ast.OptIndex{ line: t.line, col: t.col, object: node, index }
      } else if at(p, "(") {
        var args = try callArgs(p)
        node = Ast.OptCall{ line: t.line, col: t.col, callee: node, args }
      } else {
        var name = try expectIdent(p)
        node = Ast.OptField{ line: t.line, col: t.col, object: node, name }
      }
    } else if t.value == "[" {
      isPath = false
      var index = try indexExpr(p)
      node = Ast.Index{ line: t.line, col: t.col, object: node, index }
    } else {
      isPath = false
      var args = try callArgs(p)
      node = Ast.Call{ line: t.line, col: t.col, callee: node, args }
    }
    t = peek(p)
  }
  Result.ok(node)
}

// `[ expression ]` after an object, with newlines ignored inside.
func indexExpr(p: Parser): Result[Ast.Expr, Lex.Diagnostic] {
  grouped(p, "[", "]", expression)
}

// `( arg, ... )`: positional arguments, then named ones.
func callArgs(p: Parser): Result[Array[Ast.Arg], Lex.Diagnostic] {
  var seenNamed = false
  delimited(p, "(", ")", func(q: Parser): Result[Ast.Arg, Lex.Diagnostic] {
    var start = peek(q)
    var e = try expression(q)
    if e is Ast.Ident && at(q, ":") {
      next(q)
      var value = try expression(q)
      seenNamed = true
      return Result.ok(Ast.NamedArg{ line: start.line, col: start.col, name: e.name, value })
    }
    if seenNamed { return Result.err(fail(q, "positional argument after a named argument")) }
    Result.ok(Ast.PosArg{ line: start.line, col: start.col, value: e })
  })
}

// --- primary expressions

func primary(p: Parser): Result[Ast.Expr, Lex.Diagnostic] {
  var t = peek(p)
  if t.kind == "INT" {
    next(p)
    return Result.ok(Ast.Int{ line: t.line, col: t.col, text: t.value })
  }
  if t.kind == "FLOAT" {
    next(p)
    return Result.ok(Ast.Float{ line: t.line, col: t.col, text: t.value })
  }
  if t.kind == "STRING" {
    next(p)
    return Result.ok(Ast.StringLit{ line: t.line, col: t.col, text: t.value })
  }
  if t.kind == "TEMPLATE" {
    next(p)
    var parts: Array[Ast.Expr] = []
    for part in t.parts {
      Array.push(parts, try parsePart(part))
    }
    return Result.ok(Ast.Template{ line: t.line, col: t.col, text: t.value, parts, chunks: t.chunks })
  }
  if t.kind == "IDENT" {
    next(p)
    if at(p, "{") && !p.header { return braceLit(p, [t.value], t.line, t.col) }
    return Result.ok(Ast.Ident{ line: t.line, col: t.col, name: t.value })
  }
  if t.kind == "KW" { return keyword(p, t) }
  if isWord(t, "{") { return Result.ok(try lambda(p)) }
  if isWord(t, "[") { return Result.ok(try arrayLit(p)) }
  if isWord(t, "(") {
    var inner = try grouped(p, "(", ")", expression)
    return Result.ok(Ast.Paren{ line: t.line, col: t.col, inner })
  }
  Result.err(failAt(t, `unexpected ${describe(t)}`))
}

// A primary that starts with the keyword t.
func keyword(p: Parser, t: Lex.Token): Result[Ast.Expr, Lex.Diagnostic] {
  var v = t.value
  if Map.has(LITERAL_KWS, v) {
    next(p)
    return Result.ok(Ast.Lit{ line: t.line, col: t.col, text: v })
  }
  if v == "func" {
    next(p)
    if atKind(p, "IDENT") {
      return Result.err(fail(p, "a named function is only allowed at the top level; bind it with var"))
    }
    var sig = try signature(p)
    var body = try block(p)
    return Result.ok(Ast.AnonFunc{ line: t.line, col: t.col, params: sig.params, ret: sig.ret, body })
  }
  if v == "if" { return Result.ok(try ifExpr(p)) }
  if v == "while" {
    next(p)
    var cond = try headerExpr(p)
    var body = try block(p)
    return Result.ok(Ast.While{ line: t.line, col: t.col, cond, body })
  }
  if v == "for" { return Result.ok(try forExpr(p)) }
  if v == "go" {
    next(p)
    var body = try block(p)
    return Result.ok(Ast.Go{ line: t.line, col: t.col, body })
  }
  if v == "defer" {
    next(p)
    var body = try block(p)
    return Result.ok(Ast.Defer{ line: t.line, col: t.col, body })
  }
  if v == "return" {
    next(p)
    // Bare before a newline, `;`, a closer, `,` or the end of the file.
    var r = raw(p)
    if r.kind == "NEWLINE" || r.kind == "EOF" || isAny(r, RETURN_ENDERS) {
      return Result.ok(Ast.Return{ line: t.line, col: t.col, value: null })
    }
    var value = try expression(p)
    return Result.ok(Ast.Return{ line: t.line, col: t.col, value })
  }
  if v == "break" {
    next(p)
    return Result.ok(Ast.Break{ line: t.line, col: t.col })
  }
  if v == "continue" {
    next(p)
    return Result.ok(Ast.Continue{ line: t.line, col: t.col })
  }
  Result.err(failAt(t, `unexpected ${describe(t)}`))
}

// One `${...}` body of a template, lexed on its own and parsed with newlines
// ignored. The body is lexed at (1, 1) and its tokens are shifted afterwards,
// as the reference does, so a lexer error inside it is reported at part-local
// coordinates while a parser error is reported at file coordinates.
func parsePart(part: Lex.Part): Result[Ast.Expr, Lex.Diagnostic] {
  var toks = try Lex.tokenize(part.text)
  for t in toks {
    if t.line == 1 { t.col = t.col + part.col - 1 }
    t.line = t.line + part.line - 1
  }
  var q = Parser{ toks, i: 0, nl: 1, header: false }
  var e = try expression(q)
  if !atKind(q, "EOF") {
    return Result.err(fail(q, `unexpected ${describe(peek(q))} in template expression`))
  }
  Result.ok(e)
}

// The condition of an if or while, or the iterable of a for: parsed with the
// header flag set, so `{` after an identifier path opens the block.
func headerExpr(p: Parser): Result[Ast.Expr, Lex.Diagnostic] {
  var savedHeader = p.header
  p.header = true
  var e = try expression(p)
  p.header = savedHeader
  if !at(p, "{") { return Result.err(failGot(peek(p), "expected '{' after header")) }
  Result.ok(e)
}

func ifExpr(p: Parser): Result[Ast.If, Lex.Diagnostic] {
  var kw = try expect(p, "if")
  var cond = try headerExpr(p)
  var then = try block(p)
  var otherwise: Ast.Block | Ast.If | null = null
  if at(p, "else") {
    next(p)
    otherwise = if at(p, "if") { try ifExpr(p) } else { try block(p) }
  }
  Result.ok(Ast.If{ line: kw.line, col: kw.col, cond, then, otherwise })
}

func forExpr(p: Parser): Result[Ast.For, Lex.Diagnostic] {
  var kw = try expect(p, "for")
  var target: Ast.Target = if at(p, "{") { try destructure(p) } else {
    var t = peek(p)
    var name = try expectIdent(p, "loop variable")
    Ast.Name{ line: t.line, col: t.col, name }
  }
  try expect(p, "in")
  var iter = try headerExpr(p)
  var body = try block(p)
  Result.ok(Ast.For{ line: kw.line, col: kw.col, target, iter, body })
}

func destructure(p: Parser): Result[Ast.Destructure, Lex.Diagnostic] {
  var open = peek(p)
  var fields = try delimited(p, "{", "}", { aliasItem(x, "field name") })
  Result.ok(Ast.Destructure{ line: open.line, col: open.col, fields })
}

// `Path{ ... }` after an identifier path: a map literal when the path is the
// single name Map, a record literal otherwise.
func braceLit(p: Parser, path: Array[string], line: int, col: int): Result[Ast.Expr, Lex.Diagnostic] {
  var isMap = Array.length(path) == 1 && path[0] == "Map"
  var entries = try delimited(p, "{", "}", { litEntry(x, isMap) })
  if isMap { Result.ok(Ast.MapLit{ line, col, entries }) }
  else { Result.ok(Ast.RecordLit{ line, col, path, entries }) }
}

// One entry of a brace literal: `...value`, `key: value`, or a shorthand
// name. A bare identifier key in a map literal is its name as a string, both
// with and without `:`.
func litEntry(p: Parser, isMap: bool): Result[Ast.LitEntry | Ast.Spread, Lex.Diagnostic] {
  var start = peek(p)
  if at(p, "...") {
    next(p)
    if isMap { return Result.err(fail(p, "spread is not allowed in a map literal")) }
    var value = try expression(p)
    return Result.ok(Ast.Spread{ line: start.line, col: start.col, value })
  }
  var key = try expression(p)
  if at(p, ":") {
    next(p)
    var value = try expression(p)
    if !isMap && !(key is Ast.Ident) { return Result.err(fail(p, "record field must be an identifier")) }
    if isMap && key is Ast.Ident { key = keyString(key) }
    return Result.ok(Ast.LitEntry{ line: start.line, col: start.col, key, value })
  }
  if key is Ast.Ident {
    var name: Ast.Expr = if isMap { keyString(key) } else { key }
    return Result.ok(Ast.LitEntry{ line: start.line, col: start.col, key: name, value: key })
  }
  Result.err(fail(p, "shorthand entry must be an identifier"))
}

// The string literal a bare identifier key stands for in a map literal.
func keyString(key: Ast.Ident): Ast.StringLit {
  Ast.StringLit{ line: key.line, col: key.col, text: `"${key.name}"` }
}

func arrayLit(p: Parser): Result[Ast.ArrayLit, Lex.Diagnostic] {
  var open = peek(p)
  var elems = try delimited(p, "[", "]", elem)
  Result.ok(Ast.ArrayLit{ line: open.line, col: open.col, elems })
}

// One element of an array literal: `...value` or a value.
func elem(p: Parser): Result[Ast.Elem | Ast.Spread, Lex.Diagnostic] {
  var start = peek(p)
  if at(p, "...") {
    next(p)
    var value = try expression(p)
    return Result.ok(Ast.Spread{ line: start.line, col: start.col, value })
  }
  var value = try expression(p)
  Result.ok(Ast.Elem{ line: start.line, col: start.col, value })
}
