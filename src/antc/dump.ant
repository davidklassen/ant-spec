// The two dumps shared with tools/compare_frontend.py, which renders the
// reference lexer's tokens and parser's tuples in the same forms.
//
// Token dump, one token per line:
//
//   <line>:<col> <KIND> <value>    the value is left out when empty (EOF)
//     part <line>:<col> <text>     one per ${...} body, after its TEMPLATE
//
// with `\`, LF and CR escaped as `\\`, `\n`, `\r` and nothing else.
//
// AST dump, an S-expression: nil for null; strings quoted, with `"` escaped
// on top of the token escapes; lists as [a b ...]; nodes as (Kind child ...),
// where the reference's untagged tuples (import items, destructure fields,
// type parameters, parameters, record-type fields) print their name bare.
// The File node is the only multi-line one: `(File`, `  [`, one import per
// line, `  ]`, `  [`, one declaration per line, `  ]`, `)`.
import "./lexer.ant" Lex
import "./ast.ant" Ast

// The token dump, without a trailing newline.
export func tokens(toks: Array[Lex.Token]): string {
  var lines: Array[string] = []
  for t in toks {
    var head = `${t.line}:${t.col} ${t.kind}`
    Array.push(lines, if t.value == "" { head } else { `${head} ${esc(t.value)}` })
    for p in t.parts { Array.push(lines, `  part ${p.line}:${p.col} ${esc(p.text)}`) }
  }
  String.join(lines, "\n")
}

// The whole AST dump, without a trailing newline.
export func module(m: Ast.Module): string {
  var lines: Array[string] = ["(File", "  ["]
  for i in m.imports { Array.push(lines, "    " + importDecl(i)) }
  Array.push(lines, "  ]")
  Array.push(lines, "  [")
  for d in m.decls { Array.push(lines, "    " + decl(d)) }
  Array.push(lines, "  ]")
  Array.push(lines, ")")
  String.join(lines, "\n")
}

// Backslashes, newlines and carriage returns escaped so a value stays on one line.
func esc(s: string): string {
  s | String.replace("\\", "\\\\") | String.replace("\n", "\\n") | String.replace("\r", "\\r")
}

// A quoted string: the token escapes, then the quote itself.
func quote(s: string): string {
  `"${String.replace(esc(s), "\"", "\\\"")}"`
}

func list(xs: Array[string]): string {
  `[${String.join(xs, " ")}]`
}

// A list of quoted strings (type paths, `is` targets, record literal heads).
func strs(xs: Array[string]): string {
  list(Array.map(xs, quote))
}

// x rendered, or nil when it is null.
func orNil[T](x: T | null, render: func(T): string): string {
  if x == null { "nil" } else { render(x) }
}

// --- imports and declarations

func importDecl(i: Ast.Import): string {
  var pattern = i.pattern
  var text = if pattern is Ast.Namespace { `(Namespace ${quote(pattern.name)})` }
    else if pattern is Ast.Names { `(Names ${list(Array.map(pattern.items, alias))})` }
    else { "?" }
  `(Import ${quote(i.path)} ${text})`
}

func alias(a: Ast.Alias): string {
  `(${a.name} ${orNil(a.alias, quote)})`
}

func decl(d: Ast.Decl): string {
  if d is Ast.VarDecl { exported(d.exported, varDecl(d)) }
  else if d is Ast.FuncDecl {
    var sig = signature(d.params, d.ret)
    exported(d.exported, `(Func ${quote(d.name)} ${list(Array.map(d.tparams, tparam))} ${sig} ${block(d.body)})`)
  }
  else if d is Ast.TypeDecl {
    exported(d.exported, `(Type ${quote(d.name)} ${list(Array.map(d.tparams, tparam))} ${typ(d.body)})`)
  }
  else { "?" }
}

func exported(flag: bool, text: string): string {
  if flag { `(Export ${text})` } else { text }
}

func varDecl(v: Ast.VarDecl): string {
  `(Var ${target(v.target)} ${orNil(v.typ, typ)} ${expr(v.value)})`
}

func tparam(p: Ast.TypeParam): string {
  `(${p.name} ${orNil(p.bound, typ)})`
}

func param(p: Ast.Param): string {
  `(${p.name} ${typ(p.typ)} ${orNil(p.default, expr)})`
}

func signature(params: Array[Ast.Param], ret: Ast.TypeExpr | null): string {
  `(${list(Array.map(params, param))} ${orNil(ret, typ)})`
}

func target(t: Ast.Target): string {
  if t is Ast.Name { `(Name ${quote(t.name)})` }
  else if t is Ast.Destructure { `(Destructure ${list(Array.map(t.fields, alias))})` }
  else { "?" }
}

// --- types

func typ(t: Ast.TypeExpr): string {
  if t is Ast.TPath { `(TPath ${strs(t.path)} ${list(Array.map(t.args, typ))})` }
  else if t is Ast.Union { `(Union ${list(Array.map(t.terms, typ))})` }
  else if t is Ast.TRecord { `(TRecord ${list(Array.map(t.fields, fieldType))})` }
  else if t is Ast.TFunc { `(TFunc ${list(Array.map(t.params, ftParam))} ${typ(t.ret)})` }
  else { "?" }
}

func fieldType(f: Ast.FieldType): string {
  `(${f.name} ${typ(f.typ)})`
}

func ftParam(p: Ast.FtParam): string {
  `(${p.name ?? "nil"} ${typ(p.typ)})`
}

// --- statements and expressions

func block(b: Ast.Block): string {
  `(Block ${list(Array.map(b.stmts, stmt))})`
}

func stmt(s: Ast.Stmt): string {
  if s is Ast.VarDecl { varDecl(s) } else { expr(s) }
}

func expr(e: Ast.Expr): string {
  if e is Ast.Assign { `(Assign ${quote(e.op)} ${expr(e.target)} ${expr(e.value)})` }
  else if e is Ast.Pipe { `(Pipe ${expr(e.left)} ${expr(e.right)})` }
  else if e is Ast.Nullish { `(Nullish ${expr(e.left)} ${expr(e.right)})` }
  else if e is Ast.And { `(And ${expr(e.left)} ${expr(e.right)})` }
  else if e is Ast.Or { `(Or ${expr(e.left)} ${expr(e.right)})` }
  else if e is Ast.Bin { `(Bin ${quote(e.op)} ${expr(e.left)} ${expr(e.right)})` }
  else if e is Ast.Is { `(Is ${expr(e.value)} ${strs(e.target)})` }
  else if e is Ast.Unary { `(Unary ${quote(e.op)} ${expr(e.operand)})` }
  else if e is Ast.Field { `(Field ${expr(e.object)} ${quote(e.name)})` }
  else if e is Ast.OptField { `(OptField ${expr(e.object)} ${quote(e.name)})` }
  else if e is Ast.Index { `(Index ${expr(e.object)} ${expr(e.index)})` }
  else if e is Ast.OptIndex { `(OptIndex ${expr(e.object)} ${expr(e.index)})` }
  else if e is Ast.Call { `(Call ${expr(e.callee)} ${list(Array.map(e.args, arg))})` }
  else if e is Ast.OptCall { `(OptCall ${expr(e.callee)} ${list(Array.map(e.args, arg))})` }
  else if e is Ast.Int { `(Int ${quote(e.text)})` }
  else if e is Ast.Float { `(Float ${quote(e.text)})` }
  else if e is Ast.StringLit { `(String ${quote(e.text)})` }
  else if e is Ast.Template { `(Template ${quote(e.text)} ${list(Array.map(e.parts, expr))})` }
  else if e is Ast.Ident { `(Ident ${quote(e.name)})` }
  else if e is Ast.Lit { `(Lit ${quote(e.text)})` }
  else if e is Ast.AnonFunc { `(AnonFunc ${signature(e.params, e.ret)} ${block(e.body)})` }
  else if e is Ast.If { ifExpr(e) }
  else if e is Ast.While { `(While ${expr(e.cond)} ${block(e.body)})` }
  else if e is Ast.For { `(For ${target(e.target)} ${expr(e.iter)} ${block(e.body)})` }
  else if e is Ast.Go { `(Go ${block(e.body)})` }
  else if e is Ast.Defer { `(Defer ${block(e.body)})` }
  else if e is Ast.Return { `(Return ${orNil(e.value, expr)})` }
  else if e is Ast.Break { "(Break)" }
  else if e is Ast.Continue { "(Continue)" }
  else if e is Ast.Lambda { `(Lambda ${list(Array.map(e.stmts, stmt))})` }
  else if e is Ast.ArrayLit { `(ArrayLit ${list(Array.map(e.elems, elem))})` }
  else if e is Ast.Paren { `(Paren ${expr(e.inner)})` }
  else if e is Ast.MapLit { `(MapLit ${list(Array.map(e.entries, entry))})` }
  else if e is Ast.RecordLit { `(RecordLit ${strs(e.path)} ${list(Array.map(e.entries, entry))})` }
  else { "?" }
}

func ifExpr(e: Ast.If): string {
  `(If ${expr(e.cond)} ${block(e.then)} ${orNil(e.otherwise, elseBranch)})`
}

// An else branch: another if, or a block.
func elseBranch(b: Ast.Block | Ast.If): string {
  if b is Ast.If { ifExpr(b) } else { block(b) }
}

func arg(a: Ast.Arg): string {
  if a is Ast.PosArg { `(Pos ${expr(a.value)})` }
  else if a is Ast.NamedArg { `(Named ${quote(a.name)} ${expr(a.value)})` }
  else { "?" }
}

func elem(e: Ast.Elem | Ast.Spread): string {
  if e is Ast.Spread { `(Spread ${expr(e.value)})` } else { `(Elem ${expr(e.value)})` }
}

func entry(e: Ast.LitEntry | Ast.Spread): string {
  if e is Ast.Spread { `(Spread ${expr(e.value)})` } else { `(Entry ${expr(e.key)} ${expr(e.value)})` }
}
