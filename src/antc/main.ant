// antc: the Ant compiler (ROADMAP.md). Command line:
//
//   antc lex FILE              one token per line on stdout (see dump below)
//   antc parse [--dump] FILE   exit 0 when FILE parses; --dump prints the AST
//                              as the S-expression of dump.ant
//
// Diagnostics go to stderr as `path:line:col: message` with exit status 1;
// a usage error exits 2.
import "./lexer.ant" Lex
import "./parser.ant" Parser
import "./dump.ant" Dump

func main() {
  var args = Os.args()
  var command = if Array.length(args) > 0 { args[0] } else { "" }
  if command == "lex" && Array.length(args) == 2 {
    lexCommand(args[1])
  } else if command == "parse" && Array.length(args) == 2 && args[1] != "--dump" {
    parseCommand(args[1], false)
  } else if command == "parse" && Array.length(args) == 3 && args[1] == "--dump" {
    parseCommand(args[2], true)
  } else {
    eprint("usage: antc lex FILE | antc parse [--dump] FILE")
    Os.exit(2)
  }
}

// The file's text, or a diagnostic at 1:1 and exit 1.
func readSource(path: string): string {
  var read = File.read(path)
  if read is Ok { read.value } else {
    report(path, 1, 1, read.error.message)
    Os.exit(1)
  }
}

func lexCommand(path: string): void {
  var lexed = Lex.tokenize(readSource(path), 1, 1)
  var toks = if lexed is Ok { lexed.value } else {
    report(path, lexed.error.line, lexed.error.col, lexed.error.message)
    Os.exit(1)
  }
  dump(toks)
}

func parseCommand(path: string, withDump: bool): void {
  var parsed = Parser.parse(readSource(path))
  var m = if parsed is Ok { parsed.value } else {
    report(path, parsed.error.line, parsed.error.col, parsed.error.message)
    Os.exit(1)
  }
  if withDump { print(Dump.module(m)) }
}

// The token dump shared with tools/compare_frontend.py:
//   <line>:<col> <KIND> <value>    the value is left out when empty (EOF)
//     part <line>:<col> <text>     one per ${...} body, after its TEMPLATE
func dump(toks: Array[Lex.Token]): void {
  for t in toks {
    var head = `${t.line}:${t.col} ${t.kind}`
    print(if t.value == "" { head } else { `${head} ${esc(t.value)}` })
    for p in t.parts {
      print(`  part ${p.line}:${p.col} ${esc(p.text)}`)
    }
  }
}

// Backslashes, newlines and carriage returns escaped so a token stays on one line.
func esc(s: string): string {
  s | String.replace("\\", "\\\\") | String.replace("\n", "\\n") | String.replace("\r", "\\r")
}

// The one diagnostic form: path:line:col: message, on stderr.
func report(path: string, line: int, col: int, message: string): void {
  eprint(`${path}:${line}:${col}: ${message}`)
}

func eprint(text: string): void {
  if File.write("/dev/stderr", text + "\n") is Err { print(text) }
}
