// The antc lexer: source text to tokens (ant-lang.md section 2).
//
// It mirrors the Lexer of tools/antparse.py function by function, so that
// tools/compare_frontend.py can diff the two: the same tokens, and every
// error at the position the reference reports it. Token values are the raw
// source text; nothing is decoded here. The lexer walks the code points of
// the source (String.chars), so columns count code points, and a token's
// text is the join of its code points, which costs the same under every
// runtime.

export type Token = { kind: string, value: string, line: int, col: int, parts: Array[Part] }
// One `${...}` body of a template: its position (just after the `${`) and raw text.
export type Part = { line: int, col: int, text: string }
export type LexError = { line: int, col: int, message: string }

// Token kinds: OP KW IDENT INT FLOAT STRING TEMPLATE NEWLINE EOF.

type Lexer = {
  chars: Array[string],
  n: int,
  pos: int,
  line: int,
  col: int,
  toks: Array[Token],
}

var KEYWORDS = Map{
  "break": true, "continue": true, "defer": true, "else": true, "export": true,
  "false": true, "for": true, "func": true, "go": true, "if": true,
  "import": true, "in": true, "is": true, "null": true, "return": true,
  "true": true, "try": true, "type": true, "var": true, "void": true,
  "while": true,
}
var RESERVED = Map{
  "as": true, "async": true, "await": true, "class": true, "const": true,
  "enum": true, "interface": true, "match": true, "switch": true, "undefined": true,
}
// Keywords that can end an expression; every other keyword continues the line.
var ENDING_KW = Map{
  "return": true, "break": true, "continue": true, "true": true, "false": true,
  "null": true, "void": true,
}
var OPS2 = Map{
  "?.": true, "??": true, "==": true, "!=": true, "<=": true, ">=": true,
  "&&": true, "||": true, "+=": true, "-=": true, "*=": true, "/=": true, "%=": true,
}
var OPS1 = "+-*/%<>=!|.,:;()[]{}"

// Lexes src, counting positions from (startLine, startCol): (1, 1) for a
// file; the parser passes a part's position to lex a template body.
export func tokenize(src: string, startLine: int, startCol: int): Result[Array[Token], LexError] {
  var chars = String.chars(src)
  var lx = Lexer{ chars, n: Array.length(chars), pos: 0, line: startLine, col: startCol, toks: [] }
  while lx.pos < lx.n {
    var c = lx.chars[lx.pos]
    if c == "\n" {
      if !lastContinues(lx) && !nextLineContinues(lx) { emit(lx, "NEWLINE", "\n", lx.line, lx.col, []) }
      advance(lx, 1)
    } else if c == " " || c == "\t" || c == "\r" {
      advance(lx, 1)
    } else if c == "/" && peekc(lx, 1) == "/" {
      while lx.pos < lx.n && lx.chars[lx.pos] != "\n" { advance(lx, 1) }
    } else if c == "/" && peekc(lx, 1) == "*" {
      try blockComment(lx)
    } else if isDigit(c) {
      try number(lx)
    } else if isAlpha(c) || c == "_" {
      try identifier(lx)
    } else if c == "\"" {
      try stringLit(lx)
    } else if c == "`" {
      try templateLit(lx)
    } else {
      try operator(lx)
    }
  }
  if Array.length(lx.toks) > 0 && lx.toks[Array.length(lx.toks) - 1].kind != "NEWLINE" {
    emit(lx, "NEWLINE", "\n", lx.line, lx.col, [])
  }
  emit(lx, "EOF", "", lx.line, lx.col, [])
  Result.ok(lx.toks)
}

// --- state helpers

// The code point at index i, or "" past the end.
func charAt(lx: Lexer, i: int): string {
  if i < lx.n { lx.chars[i] } else { "" }
}

func peekc(lx: Lexer, k: int): string {
  charAt(lx, lx.pos + k)
}

func advance(lx: Lexer, k: int): void {
  var i = 0
  while i < k {
    if lx.pos < lx.n {
      if lx.chars[lx.pos] == "\n" {
        lx.line += 1
        lx.col = 1
      } else {
        lx.col += 1
      }
      lx.pos += 1
    }
    i += 1
  }
}

func emit(lx: Lexer, kind: string, value: string, line: int, col: int, parts: Array[Part]): void {
  Array.push(lx.toks, Token{ kind, value, line, col, parts })
}

// The source text from start up to the current position.
func text(lx: Lexer, start: int): string {
  String.concat(Array.slice(lx.chars, start, lx.pos))
}

func errAt(line: int, col: int, message: string): LexError {
  LexError{ line, col, message }
}

// An error at the current position.
func err(lx: Lexer, message: string): LexError {
  errAt(lx.line, lx.col, message)
}

// --- character classes (ASCII; each is false for "")

func isDigit(c: string): bool {
  c >= "0" && c <= "9"
}

func isAlpha(c: string): bool {
  (c >= "a" && c <= "z") || (c >= "A" && c <= "Z")
}

func isAlnum(c: string): bool {
  isDigit(c) || isAlpha(c)
}

func isHex(c: string): bool {
  isDigit(c) || (c >= "a" && c <= "f") || (c >= "A" && c <= "F")
}

// --- the newline rule (section 2, Line endings)

// Whether the last token cannot end an expression, so the newline after it
// is not a terminator.
func lastContinues(lx: Lexer): bool {
  var count = Array.length(lx.toks)
  if count == 0 { return true }
  var t = lx.toks[count - 1]
  if t.kind == "NEWLINE" { return true }
  if t.kind == "OP" {
    return !(t.value == ")" || t.value == "]" || t.value == "}" || t.value == ";" || t.value == "...")
  }
  if t.kind == "KW" { return !Map.has(ENDING_KW, t.value) }
  false
}

// Whether the next non-blank, non-comment line starts with . ?. | or else.
func nextLineContinues(lx: Lexer): bool {
  var i = lx.pos
  while i < lx.n {
    var c = lx.chars[i]
    if c == " " || c == "\t" || c == "\r" || c == "\n" {
      i += 1
    } else if c == "/" && charAt(lx, i + 1) == "/" {
      while i < lx.n && lx.chars[i] != "\n" { i += 1 }
    } else if c == "/" && charAt(lx, i + 1) == "*" {
      i += 2
      while i < lx.n && !(lx.chars[i] == "*" && charAt(lx, i + 1) == "/") { i += 1 }
      i = if i < lx.n { i + 2 } else { lx.n }
    } else {
      break
    }
  }
  var a = charAt(lx, i)
  var b = charAt(lx, i + 1)
  if a == "." && b == "." && charAt(lx, i + 2) == "." { return false }
  if a == "." || a == "|" || (a == "?" && b == ".") { return true }
  if a == "e" && b == "l" && charAt(lx, i + 2) == "s" && charAt(lx, i + 3) == "e" {
    var after = charAt(lx, i + 4)
    return after == "" || !(isAlnum(after) || after == "_")
  }
  false
}

// --- scanners; each starts at the first character of its token

// At `/*`: skips to just after the closing `*/`.
func blockComment(lx: Lexer): Result[void, LexError] {
  var line = lx.line
  var col = lx.col
  advance(lx, 2)
  while !(peekc(lx, 0) == "*" && peekc(lx, 1) == "/") {
    if peekc(lx, 0) == "" { return Result.err(errAt(line, col, "unterminated block comment")) }
    advance(lx, 1)
  }
  advance(lx, 2)
  Result.ok(void)
}

func number(lx: Lexer): Result[void, LexError] {
  var start = lx.pos
  var line = lx.line
  var col = lx.col
  var kind = "INT"
  var prefix = peekc(lx, 1)
  if lx.chars[lx.pos] == "0" && (prefix == "x" || prefix == "b") {
    var digits = if prefix == "x" { "0123456789abcdefABCDEF_" } else { "01_" }
    advance(lx, 2)
    var d = peekc(lx, 0)
    if d == "_" || (d != "" && !String.contains(digits, d)) {
      return Result.err(err(lx, "malformed number"))
    }
    while d != "" && String.contains(digits, d) {
      advance(lx, 1)
      d = peekc(lx, 0)
    }
  } else {
    decDigits(lx)
    if peekc(lx, 0) == "." && isDigit(peekc(lx, 1)) {
      kind = "FLOAT"
      advance(lx, 1)
      decDigits(lx)
    }
    var e = peekc(lx, 0)
    if e == "e" || e == "E" {
      kind = "FLOAT"
      advance(lx, 1)
      var sign = peekc(lx, 0)
      if sign == "+" || sign == "-" { advance(lx, 1) }
      if !isDigit(peekc(lx, 0)) { return Result.err(err(lx, "malformed number")) }
      decDigits(lx)
    }
  }
  // A letter, digit or `_` glued to the number: 0o17, 1x, 0b12, 1.5f.
  var nxt = peekc(lx, 0)
  if nxt != "" && (isAlnum(nxt) || nxt == "_") { return Result.err(err(lx, "malformed number")) }
  emit(lx, kind, text(lx, start), line, col, [])
  Result.ok(void)
}

func decDigits(lx: Lexer): void {
  var c = peekc(lx, 0)
  while c != "" && (isDigit(c) || c == "_") {
    advance(lx, 1)
    c = peekc(lx, 0)
  }
}

func identifier(lx: Lexer): Result[void, LexError] {
  var start = lx.pos
  var line = lx.line
  var col = lx.col
  var c = peekc(lx, 0)
  while c != "" && (isAlnum(c) || c == "_") {
    advance(lx, 1)
    c = peekc(lx, 0)
  }
  var word = text(lx, start)
  // Both errors are reported after the word, as the reference does.
  if Map.has(RESERVED, word) { return Result.err(err(lx, `reserved word '${word}'`)) }
  if word == "_" { return Result.err(err(lx, "'_' is not an identifier")) }
  var kind = if Map.has(KEYWORDS, word) { "KW" } else { "IDENT" }
  emit(lx, kind, word, line, col, [])
  Result.ok(void)
}

func operator(lx: Lexer): Result[void, LexError] {
  var c = lx.chars[lx.pos]
  var two = c + peekc(lx, 1)
  if two + peekc(lx, 2) == "..." {
    emit(lx, "OP", "...", lx.line, lx.col, [])
    advance(lx, 3)
  } else if Map.has(OPS2, two) {
    emit(lx, "OP", two, lx.line, lx.col, [])
    advance(lx, 2)
  } else if String.contains(OPS1, c) {
    emit(lx, "OP", c, lx.line, lx.col, [])
    advance(lx, 1)
  } else {
    return Result.err(err(lx, `unexpected character '${c}'`))
  }
  Result.ok(void)
}

// At a backslash, in a string or a template: validates the escape and steps
// over it. The value of a \u{...} escape is not checked here.
func escape(lx: Lexer): Result[void, LexError] {
  advance(lx, 1)
  var c = peekc(lx, 0)
  if c == "n" || c == "t" || c == "r" || c == "\\" || c == "\"" || c == "`" || c == "$" {
    advance(lx, 1)
  } else if c == "u" && peekc(lx, 1) == "{" {
    advance(lx, 2)
    var count = 0
    while isHex(peekc(lx, 0)) {
      advance(lx, 1)
      count += 1
    }
    if count == 0 || peekc(lx, 0) != "}" { return Result.err(err(lx, "bad \\u escape")) }
    advance(lx, 1)
  } else {
    return Result.err(err(lx, `bad escape '\\${c}'`))
  }
  Result.ok(void)
}

// At `"`: a plain string stays on one line.
func stringLit(lx: Lexer): Result[void, LexError] {
  var start = lx.pos
  var line = lx.line
  var col = lx.col
  advance(lx, 1)
  while lx.pos < lx.n {
    var c = lx.chars[lx.pos]
    if c == "\n" { break }
    if c == "\"" {
      advance(lx, 1)
      emit(lx, "STRING", text(lx, start), line, col, [])
      return Result.ok(void)
    }
    if c == "\\" { try escape(lx) } else { advance(lx, 1) }
  }
  Result.err(errAt(line, col, "unterminated string"))
}

// At a backtick: a template may span lines and holds `${...}` parts.
func templateLit(lx: Lexer): Result[void, LexError] {
  var start = lx.pos
  var line = lx.line
  var col = lx.col
  var parts: Array[Part] = []
  advance(lx, 1)
  while lx.pos < lx.n {
    var c = lx.chars[lx.pos]
    if c == "`" {
      advance(lx, 1)
      emit(lx, "TEMPLATE", text(lx, start), line, col, parts)
      return Result.ok(void)
    }
    if c == "\\" {
      try escape(lx)
    } else if c == "$" && peekc(lx, 1) == "{" {
      advance(lx, 2)
      var part = try embedded(lx)
      Array.push(parts, part)
    } else {
      advance(lx, 1)
    }
  }
  Result.err(errAt(line, col, "unterminated template string"))
}

// Just after `${`: scans the body to its matching `}`. Only braces, strings
// and nested templates are structural here; a nested template's own parts
// are dropped, since the parser lexes the body again.
func embedded(lx: Lexer): Result[Part, LexError] {
  var start = lx.pos
  var line = lx.line
  var col = lx.col
  var depth = 0
  while lx.pos < lx.n {
    var c = lx.chars[lx.pos]
    if c == "{" {
      depth += 1
      advance(lx, 1)
    } else if c == "}" {
      if depth == 0 {
        var body = text(lx, start)
        advance(lx, 1)
        return Result.ok(Part{ line, col, text: body })
      }
      depth -= 1
      advance(lx, 1)
    } else if c == "\"" {
      try stringLit(lx)
      Array.pop(lx.toks)
    } else if c == "`" {
      try templateLit(lx)
      Array.pop(lx.toks)
    } else {
      advance(lx, 1)
    }
  }
  Result.err(errAt(line, col, "unterminated ${ in template string"))
}
