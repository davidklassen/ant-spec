// The antc lexer: source text to tokens (ant-lang.md section 2).
//
// It follows the Lexer of tools/antparse.py closely enough that
// tools/compare_frontend.py can diff the two: the same tokens, and every
// error at the position the reference reports it. Token values are the raw
// source text; nothing is decoded here. The lexer walks the code points of
// the source (String.chars), so columns count code points, and a token's
// text is the join of its code points, which costs the same under every
// runtime.
//
// Scanning and emitting are separate: a scanner steps over its lexeme and
// says what kind it is, and `scanToken` emits the token from the mark it
// took before dispatching. The newline rule is split between `lastContinues`
// (the token before a newline) and `emit` (the token after it).

export type Token = { kind: string, value: string, line: int, col: int, parts: Array[Part] }
// One `${...}` body of a template: its position (just after the `${`) and raw text.
export type Part = { line: int, col: int, text: string }
// The one diagnostic record of the package: the lexer, the parser and later
// the checker report through it, and main.ant prints it as `path:line:col: message`.
export type Diagnostic = { line: int, col: int, message: string }

// Token kinds: OP KW IDENT INT FLOAT STRING TEMPLATE NEWLINE EOF.

type Lexer = {
  chars: Array[string],
  n: int,
  pos: int,
  line: int,
  col: int,
  toks: Array[Token],
}
// Where a token starts.
type Mark = { pos: int, line: int, col: int }

var KEYWORDS = Map{
  "break": true, "continue": true, "defer": true, "else": true, "export": true,
  "false": true, "for": true, "func": true, "go": true, "if": true,
  "import": true, "in": true, "is": true, "null": true, "return": true,
  "true": true, "try": true, "type": true, "var": true, "void": true,
  "while": true,
}
var RESERVED = Map{
  "as": true, "async": true, "await": true, "class": true, "const": true,
  "enum": true, "interface": true, "match": true, "switch": true, "undefined": true,
}
// Keywords that can end an expression; every other keyword continues the line.
var ENDING_KW = Map{
  "return": true, "break": true, "continue": true, "true": true, "false": true,
  "null": true, "void": true,
}
// Tokens that continue the previous line when they start one.
var CONTINUING = Map{ ".": true, "?.": true, "|": true, "||": true, "else": true }
var OPS2 = Map{
  "?.": true, "??": true, "==": true, "!=": true, "<=": true, ">=": true,
  "&&": true, "||": true, "+=": true, "-=": true, "*=": true, "/=": true, "%=": true,
}
var OPS1 = "+-*/%<>=!|.,:;()[]{}"

// Lexes src, counting positions from (1, 1).
export func tokenize(src: string): Result[Array[Token], Diagnostic] {
  var chars = String.chars(src)
  var lx = Lexer{ chars, n: Array.length(chars), pos: 0, line: 1, col: 1, toks: [] }
  while lx.pos < lx.n {
    var c = lx.chars[lx.pos]
    if c == " " || c == "\t" || c == "\r" {
      step(lx)
    } else if c == "/" && peekc(lx, 1) == "/" {
      scanWhile(lx, { x != "\n" })
    } else if c == "/" && peekc(lx, 1) == "*" {
      try blockComment(lx)
    } else {
      try scanToken(lx)
    }
  }
  if Array.length(lx.toks) > 0 && !lastIs(lx, "NEWLINE") { emit(lx, "NEWLINE", "\n", mark(lx), []) }
  emit(lx, "EOF", "", mark(lx), [])
  Result.ok(lx.toks)
}

// One token at the current position: a newline, or a lexeme scanned by its
// class and emitted from the mark taken before it.
func scanToken(lx: Lexer): Result[void, Diagnostic] {
  var m = mark(lx)
  var c = lx.chars[lx.pos]
  if c == "\n" {
    if !lastContinues(lx) { emit(lx, "NEWLINE", "\n", m, []) }
    step(lx)
    return Result.ok(void)
  }
  var parts: Array[Part] = []
  var kind = if isDigit(c) { try number(lx) }
    else if isAlpha(c) || c == "_" { try identifier(lx) }
    else if c == "\"" { try stringLit(lx, m); "STRING" }
    else if c == "`" { parts = try templateLit(lx, m); "TEMPLATE" }
    else { try operator(lx); "OP" }
  emit(lx, kind, text(lx, m.pos), m, parts)
  Result.ok(void)
}

// --- state helpers

// The code point k past the current one, or "" past the end.
func peekc(lx: Lexer, k: int): string {
  var i = lx.pos + k
  if i < lx.n { lx.chars[i] } else { "" }
}

// One code point forward, tracking the line and column.
func step(lx: Lexer): void {
  if lx.pos < lx.n {
    if lx.chars[lx.pos] == "\n" {
      lx.line += 1
      lx.col = 1
    } else {
      lx.col += 1
    }
    lx.pos += 1
  }
}

func advance(lx: Lexer, k: int): void {
  var i = 0
  while i < k {
    step(lx)
    i += 1
  }
}

// Steps over the run of characters satisfying pred, which must be false for
// "\n" (the column is bumped once for the run), and returns its length.
func scanWhile(lx: Lexer, pred: func(string): bool): int {
  var start = lx.pos
  while lx.pos < lx.n && pred(lx.chars[lx.pos]) { lx.pos += 1 }
  lx.col += lx.pos - start
  lx.pos - start
}

func mark(lx: Lexer): Mark {
  Mark{ pos: lx.pos, line: lx.line, col: lx.col }
}

// Whether the last token has this kind.
func lastIs(lx: Lexer, kind: string): bool {
  var count = Array.length(lx.toks)
  count > 0 && lx.toks[count - 1].kind == kind
}

// Appends a token. A line that starts with `.`, `?.`, `|`, `||` or `else`
// continues the previous one (section 2, Line endings), so such a token
// takes the place of the NEWLINE emitted before it; no other kind of token
// has one of those values.
func emit(lx: Lexer, kind: string, value: string, m: Mark, parts: Array[Part]): void {
  if Map.has(CONTINUING, value) && lastIs(lx, "NEWLINE") { Array.pop(lx.toks) }
  Array.push(lx.toks, Token{ kind, value, line: m.line, col: m.col, parts })
}

// The source text from start up to the current position.
func text(lx: Lexer, start: int): string {
  String.concat(Array.slice(lx.chars, start, lx.pos))
}

// An error at a token's start.
func errAt(m: Mark, message: string): Diagnostic {
  Diagnostic{ line: m.line, col: m.col, message }
}

// An error at the current position.
func err(lx: Lexer, message: string): Diagnostic {
  Diagnostic{ line: lx.line, col: lx.col, message }
}

// --- character classes (ASCII; each is false for "")

func isDigit(c: string): bool {
  c >= "0" && c <= "9"
}

func isAlpha(c: string): bool {
  (c >= "a" && c <= "z") || (c >= "A" && c <= "Z")
}

// A character that continues an identifier (the hot path: the ranges are
// written out rather than composed from the two classes above).
func isIdentChar(c: string): bool {
  (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "_"
}

func isHex(c: string): bool {
  isDigit(c) || (c >= "a" && c <= "f") || (c >= "A" && c <= "F")
}

// --- the newline rule (section 2, Line endings)

// Whether the last token cannot end an expression, so the newline after it
// is not a terminator.
func lastContinues(lx: Lexer): bool {
  var count = Array.length(lx.toks)
  if count == 0 { return true }
  var t = lx.toks[count - 1]
  if t.kind == "NEWLINE" { return true }
  if t.kind == "OP" {
    return !(t.value == ")" || t.value == "]" || t.value == "}" || t.value == ";" || t.value == "...")
  }
  if t.kind == "KW" { return !Map.has(ENDING_KW, t.value) }
  false
}

// --- scanners; each starts at the first character of its lexeme and steps
// over it, returning what the main loop needs to emit the token

// At `/*`: skips to just after the closing `*/`.
func blockComment(lx: Lexer): Result[void, Diagnostic] {
  var m = mark(lx)
  advance(lx, 2)
  while !(peekc(lx, 0) == "*" && peekc(lx, 1) == "/") {
    if peekc(lx, 0) == "" { return Result.err(errAt(m, "unterminated block comment")) }
    step(lx)
  }
  advance(lx, 2)
  Result.ok(void)
}

// The kind, INT or FLOAT.
func number(lx: Lexer): Result[string, Diagnostic] {
  var kind = "INT"
  var prefix = peekc(lx, 1)
  if lx.chars[lx.pos] == "0" && (prefix == "x" || prefix == "b") {
    var digits = if prefix == "x" { "0123456789abcdefABCDEF_" } else { "01_" }
    advance(lx, 2)
    var d = peekc(lx, 0)
    if d == "_" || (d != "" && !String.contains(digits, d)) {
      return Result.err(err(lx, "malformed number"))
    }
    scanWhile(lx, { String.contains(digits, x) })
  } else {
    decDigits(lx)
    if peekc(lx, 0) == "." && isDigit(peekc(lx, 1)) {
      kind = "FLOAT"
      step(lx)
      decDigits(lx)
    }
    var e = peekc(lx, 0)
    if e == "e" || e == "E" {
      kind = "FLOAT"
      step(lx)
      var sign = peekc(lx, 0)
      if sign == "+" || sign == "-" { step(lx) }
      if !isDigit(peekc(lx, 0)) { return Result.err(err(lx, "malformed number")) }
      decDigits(lx)
    }
  }
  // A letter, digit or `_` glued to the number: 0o17, 1x, 0b12, 1.5f.
  if isIdentChar(peekc(lx, 0)) { return Result.err(err(lx, "malformed number")) }
  Result.ok(kind)
}

func decDigits(lx: Lexer): void {
  scanWhile(lx, { isDigit(x) || x == "_" })
}

// The kind, KW or IDENT.
func identifier(lx: Lexer): Result[string, Diagnostic] {
  var start = lx.pos
  scanWhile(lx, isIdentChar)
  var word = text(lx, start)
  // Both errors are reported after the word, as the reference does.
  if Map.has(RESERVED, word) { return Result.err(err(lx, `reserved word '${word}'`)) }
  if word == "_" { return Result.err(err(lx, "'_' is not an identifier")) }
  Result.ok(if Map.has(KEYWORDS, word) { "KW" } else { "IDENT" })
}

func operator(lx: Lexer): Result[void, Diagnostic] {
  var c = lx.chars[lx.pos]
  var two = c + peekc(lx, 1)
  if two + peekc(lx, 2) == "..." {
    advance(lx, 3)
  } else if Map.has(OPS2, two) {
    advance(lx, 2)
  } else if String.contains(OPS1, c) {
    step(lx)
  } else {
    return Result.err(err(lx, `unexpected character '${c}'`))
  }
  Result.ok(void)
}

// At a backslash, in a string or a template: validates the escape and steps
// over it. The value of a \u{...} escape is not checked here.
func escape(lx: Lexer): Result[void, Diagnostic] {
  step(lx)
  var c = peekc(lx, 0)
  if c == "n" || c == "t" || c == "r" || c == "\\" || c == "\"" || c == "`" || c == "$" {
    step(lx)
  } else if c == "u" && peekc(lx, 1) == "{" {
    advance(lx, 2)
    var count = scanWhile(lx, isHex)
    if count == 0 || peekc(lx, 0) != "}" { return Result.err(err(lx, "bad \\u escape")) }
    step(lx)
  } else {
    return Result.err(err(lx, `bad escape '\\${c}'`))
  }
  Result.ok(void)
}

// At `"`, marked at m: a plain string stays on one line.
func stringLit(lx: Lexer, m: Mark): Result[void, Diagnostic] {
  step(lx)
  while lx.pos < lx.n {
    var c = lx.chars[lx.pos]
    if c == "\n" { break }
    if c == "\"" {
      step(lx)
      return Result.ok(void)
    }
    if c == "\\" { try escape(lx) } else { step(lx) }
  }
  Result.err(errAt(m, "unterminated string"))
}

// At a backtick, marked at m: a template may span lines and holds `${...}`
// parts, which are returned.
func templateLit(lx: Lexer, m: Mark): Result[Array[Part], Diagnostic] {
  var parts: Array[Part] = []
  step(lx)
  while lx.pos < lx.n {
    var c = lx.chars[lx.pos]
    if c == "`" {
      step(lx)
      return Result.ok(parts)
    }
    if c == "\\" {
      try escape(lx)
    } else if c == "$" && peekc(lx, 1) == "{" {
      advance(lx, 2)
      Array.push(parts, try embedded(lx))
    } else {
      step(lx)
    }
  }
  Result.err(errAt(m, "unterminated template string"))
}

// Just after `${`: scans the body to its matching `}`. Only braces, strings
// and nested templates are structural here; a nested template's own parts
// are dropped, since the parser lexes the body again.
func embedded(lx: Lexer): Result[Part, Diagnostic] {
  var m = mark(lx)
  var depth = 0
  while lx.pos < lx.n {
    var c = lx.chars[lx.pos]
    if c == "{" {
      depth += 1
      step(lx)
    } else if c == "}" {
      if depth == 0 {
        var body = text(lx, m.pos)
        step(lx)
        return Result.ok(Part{ line: m.line, col: m.col, text: body })
      }
      depth -= 1
      step(lx)
    } else if c == "\"" {
      try stringLit(lx, mark(lx))
    } else if c == "`" {
      try templateLit(lx, mark(lx))
    } else {
      step(lx)
    }
  }
  Result.err(errAt(m, "unterminated ${ in template string"))
}
