// Literal texts, which the parser keeps raw (ast.ant), decoded for the code
// generator: integers and floats with their range checks (G1), strings and
// templates with their escapes (G2), and the quoting of a string as a C
// string literal.

var INT_MAX = 9223372036854775807

// The value of an integer literal, or null when it does not fit an int.
export func intValue(text: string): int | null {
  var digits = String.replace(text, "_", "")
  var base = 10
  if String.startsWith(digits, "0x") {
    base = 16
    digits = String.slice(digits, 2, String.length(digits))
  } else if String.startsWith(digits, "0b") {
    base = 2
    digits = String.slice(digits, 2, String.length(digits))
  }
  var acc = 0
  for c in digits {
    var d = digitValue(c)
    // Ant's own arithmetic panics on overflow, so the bound is tested first.
    if acc > (INT_MAX - d) / base { return null }
    acc = acc * base + d
  }
  acc
}

func digitValue(c: string): int {
  var lower = String.toLower(c)
  var i = String.indexOf("0123456789abcdef", lower)
  i ?? 0
}

// The value of a float literal, or null when it overflows.
export func floatValue(text: string): float64 | null {
  String.toFloat(String.replace(text, "_", ""))
}

// The decoded text of a string literal (quotes included in `raw`), or the
// message `invalid escape`.
export func stringValue(raw: string): Result[string, string] {
  var chars = String.chars(raw)
  decodeRange(chars, 1, Array.length(chars) - 1)
}

// The characters of chars[from ..< to] with escapes decoded.
func decodeRange(chars: Array[string], from: int, to: int): Result[string, string] {
  var out: Array[string] = []
  var i = from
  while i < to {
    var c = chars[i]
    if c == "\\" {
      var e = try escapeAt(chars, i)
      Array.push(out, e.text)
      i = e.next
    } else {
      Array.push(out, c)
      i += 1
    }
  }
  Result.ok(String.concat(out))
}

type Escape = { text: string, next: int }

// At a backslash (validated by the lexer): the character it stands for and
// the index after the escape.
func escapeAt(chars: Array[string], i: int): Result[Escape, string] {
  var c = chars[i + 1]
  if c == "n" { return Result.ok(Escape{ text: "\n", next: i + 2 }) }
  if c == "t" { return Result.ok(Escape{ text: "\t", next: i + 2 }) }
  if c == "r" { return Result.ok(Escape{ text: "\r", next: i + 2 }) }
  if c != "u" { return Result.ok(Escape{ text: c, next: i + 2 }) }
  var j = i + 3
  var cp = 0
  while chars[j] != "}" {
    cp = cp * 16 + digitValue(chars[j])
    if cp > 1114111 { return Result.err("invalid escape") }
    j += 1
  }
  if cp >= 55296 && cp <= 57343 { return Result.err("invalid escape") }
  var text = String.fromBytes(utf8(cp)) ?? return Result.err("invalid escape")
  Result.ok(Escape{ text, next: j + 1 })
}

// The UTF-8 encoding of a code point.
func utf8(cp: int): Array[byte] {
  if cp < 128 { return [byte(cp)] }
  if cp < 2048 { return [byte(192 + cp / 64), byte(128 + cp % 64)] }
  if cp < 65536 {
    return [byte(224 + cp / 4096), byte(128 + (cp / 64) % 64), byte(128 + cp % 64)]
  }
  [byte(240 + cp / 262144), byte(128 + (cp / 4096) % 64), byte(128 + (cp / 64) % 64), byte(128 + cp % 64)]
}

// The literal chunks of a template (backticks included in `raw`): one more
// chunk than there are `${...}` parts, in order. A part's body is skipped
// the way the lexer scanned it: braces nest, strings and nested templates
// are opaque.
export func templateChunks(raw: string): Result[Array[string], string] {
  var chars = String.chars(raw)
  var n = Array.length(chars) - 1
  var chunks: Array[string] = []
  var out: Array[string] = []
  var i = 1
  while i < n {
    var c = chars[i]
    if c == "\\" {
      var e = try escapeAt(chars, i)
      Array.push(out, e.text)
      i = e.next
    } else if c == "$" && chars[i + 1] == "{" {
      Array.push(chunks, String.concat(out))
      out = []
      i = skipPart(chars, i + 2)
    } else {
      Array.push(out, c)
      i += 1
    }
  }
  Array.push(chunks, String.concat(out))
  Result.ok(chunks)
}

// Just after `${`: the index after the matching `}`.
func skipPart(chars: Array[string], start: int): int {
  var depth = 0
  var i = start
  while i < Array.length(chars) {
    var c = chars[i]
    if c == "{" {
      depth += 1
      i += 1
    } else if c == "}" {
      if depth == 0 { return i + 1 }
      depth -= 1
      i += 1
    } else if c == "\"" {
      i = skipString(chars, i + 1)
    } else if c == "`" {
      i = skipTemplate(chars, i + 1)
    } else {
      i += 1
    }
  }
  i
}

// Just after an opening `"`: the index after the closing one.
func skipString(chars: Array[string], start: int): int {
  var i = start
  while i < Array.length(chars) {
    var c = chars[i]
    if c == "\"" { return i + 1 }
    i += if c == "\\" { 2 } else { 1 }
  }
  i
}

// Just after an opening backtick: the index after the closing one.
func skipTemplate(chars: Array[string], start: int): int {
  var i = start
  while i < Array.length(chars) {
    var c = chars[i]
    if c == "`" { return i + 1 }
    if c == "\\" {
      i += 2
    } else if c == "$" && chars[i + 1] == "{" {
      i = skipPart(chars, i + 2)
    } else {
      i += 1
    }
  }
  i
}

// A decoded string as a C string literal: every byte outside printable
// ASCII, and `"`, `\` and `?`, as a three-digit octal escape (so the
// result is ASCII, built as bytes).
export func cQuote(s: string): string {
  var out: Array[byte] = [byte(34)]
  for b in String.toBytes(s) {
    var n = int(b)
    if n >= 32 && n <= 126 && n != 34 && n != 92 && n != 63 {
      Array.push(out, b)
    } else {
      Array.push(out, byte(92))
      Array.push(out, byte(48 + n / 64))
      Array.push(out, byte(48 + (n / 8) % 8))
      Array.push(out, byte(48 + n % 8))
    }
  }
  Array.push(out, byte(34))
  String.fromBytes(out) ?? panic("cQuote: not ASCII")
}

// The byte length of a string, for ant_str_lit.
export func byteLength(s: string): int {
  Array.length(String.toBytes(s))
}
