func main() {
  print(String.split("abc", "abc"))
  print(String.split("", ","))
  print(String.split("a,b,,c,", ","))
  print(String.split("aaa", "aa"))
  print(String.split("héllo", "é"))
  print(String.indexOf("aaa", "aa"))
  print(String.indexOf("héllo", "llo"))
  print(String.indexOf("abc", ""))
  print(String.indexOf("", ""))
  print(String.indexOf("abc", "d"))
  print(String.replace("aaa", "a", ""))
  print(String.replace("", "a", "b"))
  print(String.replace("aaaa", "aa", "a"))
  print(String.replace("abab", "ab", "ba"))
  print(String.replace("héllo", "é", "e"))
  print(String.replace("aaa", "a", "aa"))
  var ws = ["\u{9}", "\u{A}", "\u{B}", "\u{C}", "\u{D}", " ", "\u{85}", "\u{A0}", "\u{1680}", "\u{2000}", "\u{2001}", "\u{2002}", "\u{2003}", "\u{2004}", "\u{2005}", "\u{2006}", "\u{2007}", "\u{2008}", "\u{2009}", "\u{200A}", "\u{2028}", "\u{2029}", "\u{202F}", "\u{205F}", "\u{3000}"]
  var trimmed = Array.map(ws, { String.trim(x + "x" + x) })
  print(Array.every(trimmed, { x == "x" }))
  print(Array.length(trimmed))
  var kept = ["\u{1C}", "\u{1D}", "\u{1E}", "\u{1F}", "\u{200B}", "\u{FEFF}", "\u{180E}", "\u{0}"]
  print(Array.map(kept, { String.length(String.trim(x + "x" + x)) }))
  print(String.trim("  \t\n  "))
  print(String.trim(""))
  print(String.trim(" a b "))
  print(String.toInt("-9223372036854775808"))
  print(String.toInt("9223372036854775807"))
  print(String.toInt("9223372036854775808"))
  print(String.toInt("-9223372036854775809"))
  print(String.toInt("99999999999999999999999"))
  print(String.toInt("+0"))
  print(String.toInt("-0"))
  print(String.toInt("٣"))
  print(String.toInt(" 1"))
  print(String.toInt("1 "))
  print(String.toInt("+"))
  print(String.toInt("-"))
  print(String.toInt(""))
  print(String.toInt("007"))
  print(String.toInt("1_0"))
  print(String.toInt("0x10"))
  print(String.toInt("1.0"))
  print(String.toFloat(".5"))
  print(String.toFloat("5."))
  print(String.toFloat("inf"))
  print(String.toFloat("nan"))
  print(String.toFloat("1_0"))
  print(String.toFloat("1e"))
  print(String.toFloat("1e999"))
  print(String.toFloat("-1e-400"))
  print(String.toFloat("1E5"))
  print(String.toFloat("+1.5e+2"))
  print(String.toFloat("-0"))
  print(String.toFloat("1"))
  print(String.toFloat("0.1"))
  print(String.toFloat(" 1"))
  print(String.toFloat("1.5.5"))
  print(String.toFloat("١"))
  print(String.toFloat("1e+"))
  print(String.toFloat("1.e5"))
  print(String.toFloat("00.5"))
  print(String.toFloat("1.7976931348623157e308"))
  print(String.toFloat("1.7976931348623159e308"))
  print(String.chars(""))
  print(String.chars("aé😀"))
  print(String.slice("", 0, 0))
  print(String.slice("héllo", 1, 3))
  print(String.slice("abc", 3, 3))
  print(String.slice("a😀b", 1, 2))
  print(String.repeat("", 5))
  print(String.repeat("ab", 0))
  print(String.repeat("é", 3))
  print(String.join([], "-"))
  print(String.join(["a"], "-"))
  print(String.join(["a", "b"], ""))
  print(String.concat([]))
  print(String.concat(["a", "", "b"]))
  print(String.fromBytes([byte(0xF0), byte(0x9F), byte(0x98), byte(0x80)]))
  print(String.fromBytes([byte(0xF4), byte(0x8F), byte(0xBF), byte(0xBF)]) == "\u{10FFFF}")
  print(String.fromBytes([byte(0xF4), byte(0x90), byte(0x80), byte(0x80)]))
  print(String.fromBytes([byte(0xC1), byte(0xBF)]))
  print(String.fromBytes([byte(0xE0), byte(0x80), byte(0x80)]))
  print(String.fromBytes([byte(0xF0), byte(0x80), byte(0x80), byte(0x80)]))
  print(String.fromBytes([byte(0xED), byte(0xA0), byte(0x80)]))
  print(String.fromBytes([byte(0xE2), byte(0x82)]))
  print(String.fromBytes([byte(0x80)]))
  print(String.fromBytes([byte(0xF5), byte(0x80), byte(0x80), byte(0x80)]))
  print(String.fromBytes([byte(0x61), byte(0xC3)]))
  print(String.fromBytes([]))
  print(String.fromBytes([byte(0)]) == "\u{0}")
  print(String.length(String.fromBytes([byte(0xE2), byte(0x82), byte(0xAC)]) ?? ""))
  print(String.toBytes("é"))
  print(String.toBytes("€"))
  print(String.toBytes(""))
  print(String.toBytes("a")[0] is byte)
  print(String.length("😀é"))
  print(String.contains("", ""))
  print(String.startsWith("", ""))
  print(String.endsWith("abc", ""))
  print(String.startsWith("héllo", "hé"))
  print(String.endsWith("héllo", "llo"))
  print(String.contains("héllo", "él"))
  print(String.isEmpty(""))
  print("é" < "z")
  print("Z" < "a")
  print("" < "a")
}
