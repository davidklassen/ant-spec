func show(s: string) {
  var u = String.toUpper(s)
  var l = String.toLower(s)
  print([u, String.length(u), l, String.length(l)])
}
func main() {
  show("ß")
  show("İ")
  show("é")
  show("ı")
  show("ǅ")
  show("ǆ")
  show("Ǆ")
  show("σς")
  show("Σ")
  show("я")
  show("Я")
  show("ａ")
  show("Ａ")
  show("𐐀")
  show("𐐨")
  show("Ა")
  show("ა")
  show("Hello, Wörld! ß ı 123")
  show("")
  show("abc")
  show("ABC")
  show("a1 B\n\t")
  print(String.toLower(String.toUpper("héllo wörld")))
  print(String.toUpper("ǆ") == "Ǆ")
  print(String.length(String.toUpper("ı")))
}
