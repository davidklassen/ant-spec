type Box = { f: float32, d: float64 }
func main() {
  print(Math.pow(2.0, -24.0))
  print(Math.pow(2.0, 89.0))
  print(Math.pow(2.0, -44.0))
  print(Math.pow(2.0, 53.0))
  print(Math.pow(2.0, 63.0))
  print(Math.pow(2.0, -1074.0))
  print(Math.pow(2.0, 1023.0))
  print(1.0e23)
  print(5.0e-324)
  print(1.7976931348623157e308)
  print(2.2250738585072014e-308)
  print(1.0e-7)
  print(1.0e-6)
  print(1.0e20)
  print(1.0e21)
  print(123456789012345680000.0)
  print(100.0 / 3.0)
  print(0.1 + 0.7)
  print(9.999999999999999e22)
  print(99999.99999999999)
  print(0.000001)
  print(0.0000001)
  print(-1.5e-7)
  print(float32(0.1))
  print(float32(1.0) / float32(3.0))
  print(float32(16777216.0))
  print(float32(3.4e38))
  print(float32(1.0e-45))
  print(-float32(0.0))
  print(float32(1.0e21))
  print(float32(123456.789))
  print([float32(0.5), float32(2.5)])
  print(Box{ f: float32(1.5), d: 1.5 })
  print(`${float32(0.1)} ${1.0e-7}`)
}
