func main() {
  print(Bits.shiftLeft(int8(1), 7))
  print(Bits.shiftRight(int8(-128), 7))
  print(Bits.shiftRight(uint8(128), 7))
  print(Bits.shiftLeft(uint8(255), 1))
  print(Bits.shiftLeft(1, 63))
  print(Bits.shiftRight(-1, 63))
  print(Bits.shiftRight(Bits.not(uint64(0)), 63))
  print(Bits.shiftLeft(int8(1), 0))
  print(Bits.not(int8(0)))
  print(Bits.not(uint16(0)))
  print(Bits.not(0))
  print(Bits.wrapAdd(int8(127), int8(1)))
  print(Bits.wrapSub(uint8(0), uint8(1)))
  print(Bits.wrapMul(uint8(16), uint8(16)))
  print(Bits.wrapMul(int32(65536), int32(65536)))
  print(Bits.wrapAdd(9223372036854775807, 1))
  print(Bits.wrapSub(-9223372036854775807 - 1, 1))
  print(Bits.wrapMul(-9223372036854775807 - 1, -1))
  print(Bits.popCount(int16(-1)))
  print(Bits.popCount(-1))
  print(Bits.popCount(uint8(0)))
  print(Bits.popCount(int8(-128)) is int)
  print(Bits.and(int8(-1), int8(85)))
  print(Bits.or(uint8(240), uint8(15)))
  print(Bits.xor(int64(-1), int64(1)))
  print(Bits.shiftLeft(int16(1), 15))
  print(Bits.shiftLeft(int8(-1), 1))
  print(Bits.shiftRight(int8(-1), 7))
  print(Bits.and(int8(1), int8(1)) is int8)
  print(Bits.shiftLeft(uint8(1), 7))
  print(Bits.shiftRight(int32(-2147483648), 31))
}
