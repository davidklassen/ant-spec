func main() {
  var nan = 0.0 / 0.0
  var inf = 1.0 / 0.0
  print(Math.min(1.0, nan))
  print(Math.max(nan, 1.0))
  print(Math.min(nan, 1.0))
  print(Math.max(1.0, nan))
  print(Math.min(4, 4))
  print(Math.min("b", "a"))
  print(Math.max("b", "a"))
  print(Math.max("é", "z"))
  print(Math.abs(float32(-1.5)) is float32)
  print(Math.abs(float32(-1.5)))
  print(Math.abs(uint8(0)))
  print(Math.abs(int8(-127)))
  print(Math.abs(-0.0))
  print(Math.abs(-inf))
  print(Math.pow(0.0, -1.0))
  print(Math.pow(-0.0, -1.0))
  print(Math.pow(-8.0, 0.5))
  print(Math.pow(-8.0, 1.0 / 3.0))
  print(Math.pow(nan, 0.0))
  print(Math.pow(1.0, nan))
  print(Math.sqrt(-1.0))
  print(Math.sqrt(-0.0))
  print(Math.sqrt(inf))
  print(Math.floor(-0.0))
  print(Math.ceil(-0.5))
  print(Math.round(-0.4))
  print(Math.round(0.5))
  print(Math.round(-0.5))
  print(Math.round(2.5))
  print(Math.round(-2.5))
  print(Math.round(1.0e300))
  print(Math.floor(inf))
  print(Math.ceil(nan))
  print(Math.round(4503599627370497.0))
  print(Math.round(0.49999999999999994))
  print(Math.PI)
  print(Math.E)
  print(Math.pow(2.0, 0.5))
  print(Math.sqrt(2.0))
  print(Math.min(int8(1), int8(2)) is int8)
  print(Math.min(-0.0, 0.0))
  print(Math.max(0.0, -0.0))
  print(Math.max(uint64(1), uint64(2)))
}
